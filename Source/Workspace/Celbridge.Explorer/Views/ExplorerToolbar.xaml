<UserControl
    x:Class="Celbridge.Explorer.Views.ExplorerToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

  <!-- Explorer toolbar actions: new file, new folder, and collapse the tree. Left-aligned so the button group
       lines up with the panel title above it and the resource tree below it. -->
  <StackPanel Orientation="Horizontal"
              Spacing="0"
              HorizontalAlignment="Left">
    <Button x:Name="NewFileButton"
            Style="{StaticResource IconButtonStyle}"
            AutomationProperties.AutomationId="new-file-button"
            ToolTipService.ToolTip="{x:Bind NewFileTooltipString}"
            Click="NewFileButton_Click">
      <controls:Icon
                Symbol="FileAdd"
                FontSize="{StaticResource IconSizeMedium}" />
    </Button>
    <Button x:Name="NewFolderButton"
            Style="{StaticResource IconButtonStyle}"
            AutomationProperties.AutomationId="new-folder-button"
            ToolTipService.ToolTip="{x:Bind NewFolderTooltipString}"
            Click="NewFolderButton_Click">
      <controls:Icon
                Symbol="FolderAdd"
                FontSize="{StaticResource IconSizeMedium}" />
    </Button>
    <Button x:Name="CollapseFoldersButton"
            Style="{StaticResource IconButtonStyle}"
            AutomationProperties.AutomationId="collapse-folders-button"
            ToolTipService.ToolTip="{x:Bind CollapseFoldersTooltipString}"
            Click="CollapseFoldersButton_Click">
      <controls:Icon
                Symbol="Collapse"
                FontSize="{StaticResource IconSizeMedium}" />
    </Button>
  </StackPanel>
</UserControl>
