<UserControl
  x:Class="Celbridge.ProjectSettings.Views.ResourcesSectionView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:services="using:Celbridge.UserInterface.Services">

  <UserControl.Resources>
    <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
  </UserControl.Resources>

  <ScrollViewer Padding="12">
    <StackPanel Spacing="20">

      <StackPanel Spacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="{x:Bind ViewModel.HideTitle, Mode=OneWay}"
                     Style="{StaticResource SectionHeadingTextStyle}" />
          <TextBlock Text="{x:Bind ViewModel.HideSubtitle, Mode=OneWay}"
                     Style="{StaticResource SupportingTextStyle}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <TextBox AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="96"
                 IsSpellCheckEnabled="False"
                 PlaceholderText="{x:Bind ViewModel.PatternPlaceholder, Mode=OneWay}"
                 Text="{x:Bind ViewModel.HidePatternsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="{x:Bind ViewModel.InvalidPatternText, Mode=OneWay}"
                   Style="{StaticResource SupportingTextStyle}"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind ViewModel.HasInvalidHidePattern, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- The invariant floor, stated where someone would look for it after failing to unhide one of
             the two folders. -->
        <TextBlock Text="{x:Bind ViewModel.ProtectedNote, Mode=OneWay}"
                   Style="{StaticResource SupportingTextStyle}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="{x:Bind ViewModel.SearchExcludeTitle, Mode=OneWay}"
                     Style="{StaticResource SectionHeadingTextStyle}" />
          <TextBlock Text="{x:Bind ViewModel.SearchExcludeSubtitle, Mode=OneWay}"
                     Style="{StaticResource SupportingTextStyle}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <TextBox AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="96"
                 IsSpellCheckEnabled="False"
                 PlaceholderText="{x:Bind ViewModel.PatternPlaceholder, Mode=OneWay}"
                 Text="{x:Bind ViewModel.SearchExcludePatternsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="{x:Bind ViewModel.InvalidPatternText, Mode=OneWay}"
                   Style="{StaticResource SupportingTextStyle}"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind ViewModel.HasInvalidSearchExcludePattern, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
