<UserControl
  x:Class="Celbridge.ProjectSettings.Views.ResourcesSectionView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
  xmlns:services="using:Celbridge.UserInterface.Services">

  <UserControl.Resources>
    <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
  </UserControl.Resources>

  <ScrollViewer Padding="12">
    <StackPanel Spacing="20">

      <StackPanel Spacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="{x:Bind ViewModel.HideTitle, Mode=OneWay}"
                     Style="{StaticResource SectionHeadingTextStyle}" />
          <TextBlock Text="{x:Bind ViewModel.HideSubtitle, Mode=OneWay}"
                     Style="{StaticResource SupportingTextStyle}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <TextBox AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="96"
                 MaxHeight="240"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 IsSpellCheckEnabled="False"
                 PlaceholderText="{x:Bind ViewModel.PatternPlaceholder, Mode=OneWay}"
                 Text="{x:Bind ViewModel.HidePatternsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="{x:Bind ViewModel.InvalidPatternText, Mode=OneWay}"
                   Style="{StaticResource SupportingTextStyle}"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind ViewModel.HasInvalidHidePattern, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
      </StackPanel>

      <StackPanel Spacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="{x:Bind ViewModel.SearchExcludeTitle, Mode=OneWay}"
                     Style="{StaticResource SectionHeadingTextStyle}" />
          <TextBlock Text="{x:Bind ViewModel.SearchExcludeSubtitle, Mode=OneWay}"
                     Style="{StaticResource SupportingTextStyle}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <TextBox AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="96"
                 MaxHeight="240"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 IsSpellCheckEnabled="False"
                 PlaceholderText="{x:Bind ViewModel.PatternPlaceholder, Mode=OneWay}"
                 Text="{x:Bind ViewModel.SearchExcludePatternsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="{x:Bind ViewModel.InvalidPatternText, Mode=OneWay}"
                   Style="{StaticResource SupportingTextStyle}"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind ViewModel.HasInvalidSearchExcludePattern, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
      </StackPanel>

      <StackPanel Spacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="{x:Bind ViewModel.DownloadsFolderTitle, Mode=OneWay}"
                     Style="{StaticResource SectionHeadingTextStyle}" />
          <TextBlock Text="{x:Bind ViewModel.DownloadsFolderSubtitle, Mode=OneWay}"
                     Style="{StaticResource SupportingTextStyle}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Grid ColumnSpacing="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBox Grid.Column="0"
                   IsSpellCheckEnabled="False"
                   AutomationProperties.Name="{x:Bind ViewModel.DownloadsFolderTitle, Mode=OneWay}"
                   PlaceholderText="{x:Bind ViewModel.DefaultDownloadsFolder, Mode=OneWay}"
                   Text="{x:Bind ViewModel.DownloadsFolderText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

          <controls:IconButton Grid.Column="1"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="{x:Bind ViewModel.DownloadsFolderBrowseTooltip, Mode=OneWay}"
                               ToolTipService.ToolTip="{x:Bind ViewModel.DownloadsFolderBrowseTooltip, Mode=OneWay}"
                               Click="BrowseDownloadsFolderButton_Click">
            <controls:Icon IconName="bs-three-dots" FontSize="{StaticResource IconSizeMedium}" />
          </controls:IconButton>
        </Grid>

        <TextBlock Text="{x:Bind ViewModel.InvalidDownloadsFolderText, Mode=OneWay}"
                   Style="{StaticResource SupportingTextStyle}"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind ViewModel.IsDownloadsFolderInvalid, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
