<UserControl
  x:Class="Celbridge.ProjectSettings.Views.SafeModeSectionView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:services="using:Celbridge.UserInterface.Services">

  <UserControl.Resources>
    <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
  </UserControl.Resources>

  <ScrollViewer Padding="12">
    <StackPanel Spacing="12"
                MaxWidth="640"
                HorizontalAlignment="Left">

      <TextBlock Text="{x:Bind SafeModeCaptionText}"
                 Style="{StaticResource SectionHeadingTextStyle}"
                 TextWrapping="Wrap"/>

      <TextBlock Text="{x:Bind UntrustedText}"
                 AutomationProperties.AutomationId="project-settings-safe-mode-untrusted"
                 Style="{StaticResource SupportingTextStyle}"
                 TextWrapping="Wrap"
                 Visibility="{x:Bind ViewModel.IsTrusted, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}"/>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{x:Bind TrustProjectText}"
                AutomationProperties.AutomationId="project-settings-safe-mode-trust-button"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.TrustProjectCommand}"
                Visibility="{x:Bind ViewModel.IsTrusted, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}"/>
        <Button Content="{x:Bind ViewLoadReportText}"
                ToolTipService.ToolTip="{x:Bind ViewLoadReportTooltip}"
                Command="{x:Bind ViewModel.InformationSection.OpenLoadReportCommand}"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
