<UserControl
  x:Class="Celbridge.ProjectSettings.Views.FeatureFlagsSectionView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Celbridge.ProjectSettings.ViewModels">

  <UserControl.Resources>

    <DataTemplate x:Key="FeatureFlagTemplate" x:DataType="vm:FeatureFlagItemViewModel">
      <StackPanel Spacing="2">
        <TextBlock Text="{x:Bind Title}"
                   Style="{StaticResource FieldLabelTextStyle}" />
        <ToggleSwitch HorizontalAlignment="Left"
                      MinWidth="0"
                      OnContent=""
                      OffContent=""
                      AutomationProperties.Name="{x:Bind Title}"
                      ToolTipService.ToolTip="{x:Bind DefaultTooltip}"
                      IsOn="{x:Bind IsOn, Mode=TwoWay}" />
        <TextBlock Text="{x:Bind Description}"
                   Style="{StaticResource SupportingTextStyle}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="FeatureFlagGroupTemplate" x:DataType="vm:FeatureFlagGroupViewModel">
      <Expander HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Margin="0,0,0,8">
        <Expander.Header>
          <TextBlock Text="{x:Bind Title}"
                     Style="{StaticResource ListItemTitleTextStyle}"
                     VerticalAlignment="Center" />
        </Expander.Header>

        <ItemsControl ItemsSource="{x:Bind Flags}"
                      ItemTemplate="{StaticResource FeatureFlagTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Expander>
    </DataTemplate>

  </UserControl.Resources>

  <ScrollViewer Padding="12">
    <StackPanel>
      <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}"
                    ItemTemplate="{StaticResource FeatureFlagGroupTemplate}" />

      <Button HorizontalAlignment="Left"
              Content="{x:Bind ViewModel.ResetButtonText}"
              ToolTipService.ToolTip="{x:Bind ViewModel.ResetButtonTooltip}"
              Command="{x:Bind ViewModel.ResetToDefaultsCommand}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
