<UserControl
  x:Class="Celbridge.ProjectSettings.Views.ProjectSettingsPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Celbridge.ProjectSettings.Views"
  xmlns:controls="using:Celbridge.WorkspaceUI.Views"
  xmlns:icon="using:Celbridge.UserInterface.Views.Controls"
  xmlns:services="using:Celbridge.UserInterface.Services"
  xmlns:ui="using:Celbridge.UserInterface"
  DataContext="{x:Bind ViewModel}"
  Background="Transparent"
  ui:FocusTracking.Panel="ProjectSettings">

  <UserControl.Resources>

    <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

  </UserControl.Resources>

  <Grid Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <controls:PanelHeader x:Name="PanelHeader"
                          Grid.Row="0"
                          ShowFocusIndicator="False"
                          Tapped="PanelHeader_Tapped"
                          Title="{x:Bind ViewModel.TitleText, Mode=OneWay}"/>

    <!-- Icon tab strip plus the active section name. Each tab is an icon toggle with a tooltip (shown below
         the icon) carrying its label, taking the same selected treatment as every other toggle in the
         application. -->
    <Border Grid.Row="1"
            BorderBrush="{ThemeResource DividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,6,12,8">
      <StackPanel Spacing="6">

        <StackPanel Orientation="Horizontal" Spacing="4">

          <ToggleButton Tag="0"
                        Style="{StaticResource IconToggleButtonStyle}"
                        IsChecked="{x:Bind ViewModel.IsInformationSection, Mode=OneWay}"
                        Click="NavTab_Click"
                        ToolTipService.ToolTip="{x:Bind InformationHeader}"
                        ToolTipService.Placement="Bottom">
            <icon:Icon IconName="bs-info-circle" FontSize="18"/>
          </ToggleButton>

          <ToggleButton Tag="1"
                        Style="{StaticResource IconToggleButtonStyle}"
                        IsChecked="{x:Bind ViewModel.IsPackagesSection, Mode=OneWay}"
                        Click="NavTab_Click"
                        ToolTipService.ToolTip="{x:Bind PackagesHeader}"
                        ToolTipService.Placement="Bottom">
            <Grid>
              <icon:Icon IconName="bs-box-seam" FontSize="18"/>

              <!-- Reports that the section has something to look at; the detail is on the package. -->
              <Ellipse Width="6"
                       Height="6"
                       Margin="0,-2,-7,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Fill="{ThemeResource SystemFillColorCautionBrush}"
                       ToolTipService.ToolTip="{x:Bind ViewModel.PackagesSectionIssuesTooltip}"
                       ToolTipService.Placement="Bottom"
                       Visibility="{x:Bind ViewModel.HasPackagesSectionIssues, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
          </ToggleButton>

          <ToggleButton Tag="2"
                        Style="{StaticResource IconToggleButtonStyle}"
                        IsChecked="{x:Bind ViewModel.IsPagesSection, Mode=OneWay}"
                        Click="NavTab_Click"
                        ToolTipService.ToolTip="{x:Bind PagesHeader}"
                        ToolTipService.Placement="Bottom">
            <icon:Icon IconName="bs-globe" FontSize="18"/>
          </ToggleButton>

          <ToggleButton Tag="3"
                        Style="{StaticResource IconToggleButtonStyle}"
                        IsChecked="{x:Bind ViewModel.IsFileEditorsSection, Mode=OneWay}"
                        Click="NavTab_Click"
                        ToolTipService.ToolTip="{x:Bind FileEditorsHeader}"
                        ToolTipService.Placement="Bottom">
            <icon:Icon IconName="bs-file-earmark" FontSize="18"/>
          </ToggleButton>

          <ToggleButton Tag="4"
                        Style="{StaticResource IconToggleButtonStyle}"
                        IsChecked="{x:Bind ViewModel.IsFeatureFlagsSection, Mode=OneWay}"
                        Click="NavTab_Click"
                        ToolTipService.ToolTip="{x:Bind FeatureFlagsHeader}"
                        ToolTipService.Placement="Bottom">
            <icon:Icon IconName="bs-flag" FontSize="18"/>
          </ToggleButton>

        </StackPanel>

        <StackPanel Spacing="2" Margin="2,2,0,0">
          <TextBlock Text="{x:Bind ViewModel.ActiveSectionName, Mode=OneWay}"
                     Style="{StaticResource SectionHeadingTextStyle}"/>
          <TextBlock Text="{x:Bind ViewModel.ActiveSectionDescription, Mode=OneWay}"
                     Style="{StaticResource SupportingTextStyle}"
                     TextWrapping="Wrap"/>
        </StackPanel>

      </StackPanel>
    </Border>

    <!-- The active section's view. Each is its own control bound to its section view model; the shell
         toggles which one is visible. -->
    <Grid Grid.Row="2">
      <local:InformationSectionView
          ViewModel="{x:Bind ViewModel.InformationSection}"
          Visibility="{x:Bind ViewModel.IsInformationSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
      <local:PackagesSectionView
          ViewModel="{x:Bind ViewModel.PackagesSection}"
          Visibility="{x:Bind ViewModel.IsPackagesSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
      <local:PagesSectionView
          ViewModel="{x:Bind ViewModel.PagesSection}"
          Visibility="{x:Bind ViewModel.IsPagesSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
      <local:FileEditorsSectionView
          ViewModel="{x:Bind ViewModel.FileEditorsSection}"
          Visibility="{x:Bind ViewModel.IsFileEditorsSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
      <local:FeatureFlagsSectionView
          ViewModel="{x:Bind ViewModel.FeatureFlagsSection}"
          Visibility="{x:Bind ViewModel.IsFeatureFlagsSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>

    <!-- The button takes the accent style while an edit is waiting on a reload, applied in code-behind. -->
    <Border Grid.Row="3"
            Background="{ThemeResource ContentBackgroundBrush}"
            BorderBrush="{ThemeResource DividerBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,8">
      <StackPanel Spacing="6">
        <TextBlock Text="{x:Bind ReloadCaptionText}"
                   Style="{StaticResource SupportingTextStyle}"
                   TextWrapping="Wrap"/>
        <Button x:Name="ReloadProjectButton"
                HorizontalAlignment="Stretch"
                MaxWidth="240"
                Content="{x:Bind ReloadProjectText}"
                Command="{x:Bind ViewModel.ReloadProjectCommand}"/>
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
