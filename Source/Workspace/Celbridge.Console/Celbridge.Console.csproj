<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.22621;net10.0-desktop</TargetFrameworks>
    <UnoDisableVSWarnNetIsFirst>true</UnoDisableVSWarnNetIsFirst>
    <UnoSingleProject>true</UnoSingleProject>
    <OutputType>Library</OutputType>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <UnoFeatures>
      CSharpMarkup;
      Lottie;
      Hosting;
      Toolkit;
      Logging;
      Mvvm;
      Configuration;
      Localization;
      ThemeService;
    </UnoFeatures>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="Tomlyn" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Web\**" />
    <!-- Vendored libraries live in `Web/**/lib/` and ship with the app.
         The `build/` subfolder holds the npm tooling used to refresh them
         and is not a runtime asset. -->
    <Content Remove="Web\**\lib\build\**" />
    <!-- The tests run under Vitest from the package folder, which keeps its results cache in node_modules.
         None of it is a runtime asset. -->
    <Content Remove="Web\**\tests\**" />
    <Content Remove="Web\**\node_modules\**" />
    <Content Remove="Web\**\package.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shells' start-up scripts. ConsoleStartupFiles reads them as text, fills in a few values, and writes
         them into the project's console folder. -->
    <EmbeddedResource Include="StartupScripts\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Celbridge.FileSystem\Celbridge.FileSystem.csproj" />
    <ProjectReference Include="..\..\Core\Celbridge.Foundation\Celbridge.Foundation.csproj" />
    <ProjectReference Include="..\..\Core\Celbridge.UserInterface\Celbridge.UserInterface.csproj" />
    <ProjectReference Include="..\..\Core\Celbridge.Utilities\Celbridge.Utilities.csproj" />
    <ProjectReference Include="..\..\Core\Celbridge.WebHost\Celbridge.WebHost.csproj" />
    <ProjectReference Include="..\Celbridge.Python\Celbridge.Python.csproj" />
  </ItemGroup>

</Project>

