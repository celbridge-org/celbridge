<UserControl
    x:Class="Celbridge.Documents.Views.WorkspacePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Celbridge.Documents.Views"
    xmlns:workspace="using:Celbridge.WorkspaceUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
  <Grid>
    <!-- The layout container owns the workspace geometry and hosts the Utility Panel. The document
         sections inside its area grids are managed by the DocumentSectionContainer coordinator, wired
         up in code-behind. The Documents focus-tracking identity is declared per area grid inside the
         layout container, because the Utility Panel shares that tree and keeps its own. -->
    <workspace:WorkspaceLayoutContainer x:Name="LayoutContainer"/>
    <!-- Topmost display-only layer for tab drag visuals (ghost and insertion indicator) -->
    <Canvas x:Name="TabDragOverlay"
            IsHitTestVisible="False"/>
  </Grid>
</UserControl>
