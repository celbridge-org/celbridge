<UserControl
  x:Class="Celbridge.WorkspaceUI.Views.NotificationBar"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Celbridge.WorkspaceUI.Views"
  xmlns:services="using:Celbridge.UserInterface.Services">

  <UserControl.Resources>
    <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
  </UserControl.Resources>

  <Border Background="{ThemeResource ChromeBackgroundBrush}"
          Visibility="{x:Bind ViewModel.IsBannerVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

    <!-- One banner at a time, held under a fixed ceiling. A project load can raise several conditions, and
         the bar sits in the workspace grid, so anything that grows with the number of them takes that space
         from the surfaces. Dismissing the banner brings the next one up in its place. -->
    <InfoBar x:Name="BannerInfoBar"
             MaxHeight="{StaticResource NotificationBarMaxHeight}"
             Severity="{x:Bind ViewModel.BannerSeverity, Mode=OneWay}"
             CornerRadius="0"
             BorderThickness="0"
             Margin="0"
             IsOpen="{x:Bind ViewModel.IsBannerVisible, Mode=OneWay}"
             IsClosable="{x:Bind ViewModel.IsBannerDismissable, Mode=OneWay}"
             Title="{x:Bind ViewModel.BannerTitle, Mode=OneWay}"
             Message="{x:Bind ViewModel.BannerMessage, Mode=OneWay}"
             Closed="OnBannerClosed">
      <InfoBar.ActionButton>
        <Button Content="{x:Bind ViewModel.ActionText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsActionVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                Click="{x:Bind ViewModel.OnActionClicked}"/>
      </InfoBar.ActionButton>
    </InfoBar>
  </Border>
</UserControl>
