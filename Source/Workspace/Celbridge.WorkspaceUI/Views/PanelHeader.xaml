<UserControl
  x:Class="Celbridge.WorkspaceUI.Views.PanelHeader"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
  xmlns:local="using:Celbridge.WorkspaceUI.Views">

  <!-- Left padding aligns the title with the toolbar glyphs below it. The focus indicator's column collapses
       on the panels that hide it. -->
  <Grid Height="40"
        Padding="8,0,0,0"
        Background="{ThemeResource ContentBackgroundBrush}"
        DoubleTapped="TitleBar_DoubleTapped">

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- Focus Indicator -->
    <local:PanelFocusIndicator x:Name="FocusIndicatorControl"
                               Grid.Column="0"
                               Margin="6,0,0,0"/>

    <!-- Title -->
    <TextBlock Grid.Column="1"
               Text="{x:Bind Title, Mode=OneWay}"
               Style="{StaticResource PanelTitleTextStyle}"
               Margin="6,0,0,0"
               VerticalAlignment="Center"/>

    <!-- Toolbar Content Slot -->
    <ContentPresenter Grid.Column="3"
                      Content="{x:Bind ToolbarContent, Mode=OneWay}"
                      VerticalAlignment="Center"
                      Margin="0,0,4,0"/>

    <!-- Collapse Button. The chevron points towards the edge the panel collapses into, which depends on the
         surface the header sits in, so it is set in code-behind rather than declared here. -->
    <Button x:Name="CollapseButton"
            Grid.Column="4"
            Style="{StaticResource IconButtonStyle}"
            ToolTipService.ToolTip="{x:Bind CollapseButtonTooltip}"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            Click="CollapseButton_Click">
      <controls:Icon x:Name="CollapseButtonIcon"
                     FontSize="{StaticResource IconSizeMedium}" />
    </Button>
  </Grid>
</UserControl>
