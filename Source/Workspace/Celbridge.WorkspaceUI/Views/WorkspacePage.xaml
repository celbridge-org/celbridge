<Page
  x:Class="Celbridge.WorkspaceUI.Views.WorkspacePage"
  x:Name="WorkspacePageName"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Celbridge.WorkspaceUI.Views"
  xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
  xmlns:layout="using:Celbridge.WorkspaceUI"
  xmlns:vm="using:Celbridge.WorkspaceUI.ViewModels"
  NavigationCacheMode="Required"
  DataContext="{x:Bind ViewModel}">

  <Grid x:Name="LayoutRoot"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="UtilityPanelColumn"
                        Width="300"
                        MinWidth="200"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Utility Panel -->
    <Grid x:Name="UtilityPanelHost"
          Grid.RowSpan="2"
          MinWidth="200"
          layout:WorkspaceLayout.Region="UtilityPanel"
          AutomationProperties.AutomationId="explorer-panel"
          Background="{ThemeResource PanelBackgroundABrush}">
    </Grid>

    <!-- Documents Panel. Hosts the Main, Bottom and Side document areas and the splitters
         between them. -->
    <Grid x:Name="DocumentsPanelHost"
          Grid.Column="1"
          Grid.Row="0"
          AutomationProperties.AutomationId="documents-panel"
          Background="{ThemeResource ApplicationBackgroundBrush}">
    </Grid>

    <!-- Notification Bar. Spans the workspace to the right of the Utility Panel and sizes to its
         content, so it takes no space when no banners are showing. -->
    <Grid x:Name="NotificationBarHost"
          Grid.Column="1"
          Grid.Row="1"
          AutomationProperties.AutomationId="notification-bar">
    </Grid>

    <controls:Splitter x:Name="UtilityPanelSplitter"
                       Grid.Column="0"
                       Grid.RowSpan="2"
                       HorizontalAlignment="Right"
                       Orientation="Vertical"/>

    <!-- Topmost display-only overlay for pointer-driven resource drag visuals (the ghost),
         spanning every panel so the ghost is visible across the whole workspace. -->
    <Canvas x:Name="ResourceDragOverlay"
            Grid.Row="0"
            Grid.Column="0"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            IsHitTestVisible="False"/>
  </Grid>
</Page>
