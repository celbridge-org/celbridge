<Page
  x:Class="Celbridge.WorkspaceUI.Views.WorkspacePage"
  x:Name="WorkspacePageName"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Celbridge.WorkspaceUI.Views"
  xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
  xmlns:layout="using:Celbridge.WorkspaceUI"
  xmlns:vm="using:Celbridge.WorkspaceUI.ViewModels"
  NavigationCacheMode="Required"
  DataContext="{x:Bind ViewModel}">

  <!-- The workspace is a recessed field that the panels sit in, so every boundary between two of them
       shows as a gutter. The edges where a panel meets the application border are left flush: the window
       is its own boundary and does not need pixels spent on one. -->
  <Grid x:Name="LayoutRoot"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{ThemeResource GutterBrush}">

    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="UtilityPanelColumn"
                        Width="300"
                        MinWidth="200"/>
      <!-- Sized by the splitter that sits in it, and collapses with it when the Utility Panel is hidden. -->
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
      <!-- Separates the panels from the title bar. The only gutter with no splitter in it, so it carries
           its own copy of the gutter width that Splitter.GrabAreaSize defaults to. -->
      <RowDefinition Height="7"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Utility Panel -->
    <Grid x:Name="UtilityPanelHost"
          Grid.Row="1"
          Grid.RowSpan="2"
          MinWidth="200"
          layout:WorkspaceLayout.Surface="UtilityPanel"
          AutomationProperties.AutomationId="explorer-panel"
          Background="{ThemeResource PanelBackgroundABrush}"
          BorderBrush="{ThemeResource DividerBrush}"
          BorderThickness="0,1,1,0">
    </Grid>

    <!-- Documents Panel. Hosts the Main, Bottom and Side document areas and the splitters
         between them. -->
    <Grid x:Name="DocumentsPanelHost"
          Grid.Column="2"
          Grid.Row="1"
          AutomationProperties.AutomationId="documents-panel"
          Background="{ThemeResource GutterBrush}">
    </Grid>

    <!-- Notification Bar. Spans the workspace to the right of the Utility Panel and sizes to its
         content, so it takes no space when no banners are showing. -->
    <Grid x:Name="NotificationBarHost"
          Grid.Column="2"
          Grid.Row="2"
          AutomationProperties.AutomationId="notification-bar">
    </Grid>

    <!-- Sits in its own gutter column rather than docked inside the Utility Panel, so the boundary reads
         the same as the ones between document areas. It draws nothing at rest. -->
    <controls:Splitter x:Name="UtilityPanelSplitter"
                       Grid.Column="1"
                       Grid.Row="1"
                       Grid.RowSpan="2"
                       Orientation="Vertical"/>

    <!-- Topmost display-only overlay for pointer-driven resource drag visuals (the ghost),
         spanning every panel so the ghost is visible across the whole workspace. -->
    <Canvas x:Name="ResourceDragOverlay"
            Grid.Row="0"
            Grid.Column="0"
            Grid.RowSpan="3"
            Grid.ColumnSpan="3"
            IsHitTestVisible="False"/>
  </Grid>
</Page>
