<UserControl
  x:Class="Celbridge.WorkspaceUI.Views.WorkspaceView"
  x:Name="WorkspaceViewName"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Celbridge.WorkspaceUI.Views"
  xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
  xmlns:layout="using:Celbridge.WorkspaceUI"
  xmlns:vm="using:Celbridge.WorkspaceUI.ViewModels"
  DataContext="{x:Bind ViewModel}">

  <!-- The workspace surfaces and the splitters between them are laid out by the workspace panel, which
       holds them in one grid so the Bottom area can span across the Utility Panel. -->
  <Grid x:Name="LayoutRoot"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{ThemeResource ChromeBackgroundBrush}">

    <Grid x:Name="WorkspacePanelHost"
          AutomationProperties.AutomationId="documents-panel"
          Background="{ThemeResource ChromeBackgroundBrush}"/>

    <!-- Topmost display-only overlay for pointer-driven resource drag visuals (the ghost),
         spanning every panel so the ghost is visible across the whole workspace. -->
    <Canvas x:Name="ResourceDragOverlay"
            IsHitTestVisible="False"/>
  </Grid>
</UserControl>
