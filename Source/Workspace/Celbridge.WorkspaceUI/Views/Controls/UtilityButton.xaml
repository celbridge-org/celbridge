<UserControl
    x:Class="Celbridge.WorkspaceUI.Views.Controls.UtilityButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
    IsTabStop="False">

    <!-- One rail cell. The rail column carries the whole band across to the panel, so the square button
         centred in a square cell is what holds the channel open, and the gap it leaves either side matches
         the gap above and below it. -->
    <Grid Height="40">
        <VisualStateManager.VisualStateGroups>
            <!-- One group rather than separate selection and pointer groups: a selected button keeps its own
                 tone under the pointer, so the states are the four the two inputs actually produce. -->
            <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="UnselectedPointerOver">
                    <VisualState.Setters>
                        <Setter Target="ButtonFill.Background" Value="{ThemeResource ButtonHoverBackgroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SelectedUnfocused">
                    <!-- The utility the panel is showing, without the keyboard: a neutral fill. -->
                    <VisualState.Setters>
                        <Setter Target="ButtonFill.Background" Value="{ThemeResource ButtonActiveBackgroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SelectedFocused">
                    <!-- Holding the keyboard: the accent fills the button, with the glyph in the tone
                         chosen to read against it. -->
                    <VisualState.Setters>
                        <Setter Target="ButtonFill.Background" Value="{ThemeResource AccentBrush}" />
                        <Setter Target="IconElement.Foreground" Value="{ThemeResource AccentTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- The fill behind the glyph, carrying hover and selection. Not hit-testable, so it never blocks the
             click target above it. -->
        <Border x:Name="ButtonFill"
                Width="32"
                Height="32"
                CornerRadius="{StaticResource IconButtonCornerRadius}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                IsHitTestVisible="False" />

        <!-- Click target over the whole cell, so the channel either side of the button stays clickable. Its
             own fills are cleared to transparent because ButtonFill draws every state. -->
        <Button x:Name="ButtonElement"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="0"
                BorderThickness="0"
                IsTabStop="False"
                PointerEntered="ButtonElement_PointerEntered"
                PointerExited="ButtonElement_PointerExited"
                Click="ButtonElement_Click">
            <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
            </Button.Resources>
        </Button>

        <!-- Icon centered in the cell, above the button but passing clicks through to it. Sized to the icon so
             the pip aligns to the glyph's corner. -->
        <Grid Width="{StaticResource IconSizeMedium}"
              Height="{StaticResource IconSizeMedium}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsHitTestVisible="False">
            <!-- The Viewbox measures the glyph unconstrained then scales it to fit the box. A bare FontIcon
                 sized to its own box clips glyphs whose ink reaches the top of the em (e.g. the Search
                 magnifying glass); the Viewbox gives every glyph the same fitted headroom. -->
            <Viewbox Stretch="Uniform"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <controls:Icon x:Name="IconElement"
                               FontSize="{StaticResource IconSizeMedium}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
            </Viewbox>

            <!-- Caution pip for a surface reporting a problem, offset clear of the glyph's corner. -->
            <Ellipse x:Name="IssuePip"
                     Width="6"
                     Height="6"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-3,-5,0"
                     Fill="{ThemeResource SystemFillColorCautionBrush}"
                     Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
