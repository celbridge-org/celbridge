<UserControl
    x:Class="Celbridge.WorkspaceUI.Views.WorkspaceSurfaceContainer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
    xmlns:layout="using:Celbridge.WorkspaceUI"
    xmlns:ui="using:Celbridge.UserInterface">

  <!-- The workspace is a field that the surfaces sit in. Every gap between two surfaces is one of the
       splitter grab bands, so the field shows through as the channel between them and costs no extra
       space. All of the surfaces share this one grid so the Bottom area can span across its neighbours:
       which columns it takes is what the Bottom area alignment sets. The document-area grids are bare
       containers; the sections inside them are managed by the documents panel. -->
  <Grid x:Name="RootGrid"
        Background="{ThemeResource ChromeBackgroundBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="UtilityPanelColumn"
                        Width="300"
                        MinWidth="200"/>
      <!-- Sized by the splitter that sits in it, and collapses with it when the Utility Panel is hidden. -->
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition x:Name="MainAreaColumn"
                        Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition x:Name="SideAreaColumn"
                        Width="300"
                        MinWidth="200"/>
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
      <!-- Sets the document areas down from the title bar so their top corners read, while the Utility
           Panel runs up into it. Sized from GutterSize in code-behind to match the channels between areas. -->
      <RowDefinition x:Name="DocumentAreaGutterRow"/>
      <RowDefinition x:Name="MainAreaRow"
                     Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition x:Name="BottomAreaRow"
                     Height="350"
                     MinHeight="150"/>
    </Grid.RowDefinitions>

    <Grid x:Name="UtilityPanelHost"
          Grid.Row="0"
          Grid.RowSpan="4"
          Grid.Column="0"
          MinWidth="200"
          layout:WorkspaceLayout.Surface="UtilityPanel"
          AutomationProperties.AutomationId="explorer-panel"
          Background="{ThemeResource ChromeBackgroundBrush}"/>

    <!-- Sits in its own gutter column rather than docked inside the Utility Panel, so the boundary reads
         the same as the ones between document areas. It draws nothing at rest. -->
    <controls:Splitter x:Name="UtilityPanelSplitter"
                       Grid.Row="1"
                       Grid.RowSpan="3"
                       Grid.Column="1"
                       Orientation="Vertical"/>

    <!-- The document-area grids carry the Documents focus-tracking identity, which is why it is declared
         here per host and not on an ancestor: the Utility Panel shares this tree and keeps its own. -->
    <Grid x:Name="MainAreaGrid"
          Grid.Row="1"
          Grid.Column="2"
          ui:FocusTracking.Panel="Documents"
          AutomationProperties.AutomationId="main-area"/>

    <!-- The splitters draw nothing at rest. They only sit in the gutter to resize it, and light up with the
         accent line on hover and drag. -->
    <controls:Splitter x:Name="BottomAreaSplitter"
                       Grid.Row="2"
                       Grid.Column="2"
                       Orientation="Horizontal"/>

    <Grid x:Name="BottomAreaGrid"
          Grid.Row="3"
          Grid.Column="2"
          layout:WorkspaceLayout.Surface="BottomArea"
          ui:FocusTracking.Panel="Documents"
          AutomationProperties.AutomationId="bottom-area"/>

    <controls:Splitter x:Name="SideAreaSplitter"
                       Grid.Row="1"
                       Grid.RowSpan="3"
                       Grid.Column="3"
                       Orientation="Vertical"/>

    <Grid x:Name="SideAreaGrid"
          Grid.Row="1"
          Grid.RowSpan="3"
          Grid.Column="4"
          layout:WorkspaceLayout.Surface="SideArea"
          ui:FocusTracking.Panel="Documents"
          AutomationProperties.AutomationId="side-area"/>
  </Grid>
</UserControl>
