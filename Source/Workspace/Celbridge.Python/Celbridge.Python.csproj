<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.22621;net10.0-desktop</TargetFrameworks>
    <UnoDisableVSWarnNetIsFirst>true</UnoDisableVSWarnNetIsFirst>
    <UnoSingleProject>true</UnoSingleProject>
    <OutputType>Library</OutputType>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <UnoFeatures>
      CSharpMarkup;
      Lottie;
      Hosting;
      Toolkit;
      Logging;
      Mvvm;
      Configuration;
      Localization;
      ThemeService;
    </UnoFeatures>

    <!-- Suppress PRI249 false-positive warnings caused by Python wheel filenames (e.g. py3-none-any) -->
    <!-- being incorrectly parsed as Windows resource qualifiers by the PRI indexer. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);PRI249</MSBuildWarningsAsMessages>

    <!-- The wheel is generated during the build and re-included by IncludeGeneratedPythonWheel.
         Excluding it from the default Assets glob avoids a duplicate MSIX payload (APPX1101) on the
         packaged Windows head. -->
    <CelbridgeDefaultItemExcludes>$(CelbridgeDefaultItemExcludes);Assets\Python\*.whl</CelbridgeDefaultItemExcludes>

  </PropertyGroup>

  <!-- Download uv binary from GitHub releases if not already present -->
  <PropertyGroup>
    <!-- Set by a build that needs the assembly but not the app's Python asset, so uv is neither
         downloaded nor run. -->
    <SkipCelbridgeWheelBuild Condition="'$(SkipCelbridgeWheelBuild)' == ''">false</SkipCelbridgeWheelBuild>
    <UvVersion>0.10.11</UvVersion>
    <UvPlatform Condition="$([MSBuild]::IsOSPlatform('Windows'))">x86_64-pc-windows-msvc</UvPlatform>
    <UvPlatform Condition="$([MSBuild]::IsOSPlatform('OSX')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">aarch64-apple-darwin</UvPlatform>
    <UvPlatform Condition="$([MSBuild]::IsOSPlatform('OSX')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">x86_64-apple-darwin</UvPlatform>
    <UvPlatform Condition="$([MSBuild]::IsOSPlatform('Linux')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">x86_64-unknown-linux-gnu</UvPlatform>
    <UvPlatform Condition="$([MSBuild]::IsOSPlatform('Linux')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">aarch64-unknown-linux-gnu</UvPlatform>
    <!-- The Windows uv release is a .zip; the macOS and Linux releases are .tar.gz archives. -->
    <UvArchiveExtension Condition="$([MSBuild]::IsOSPlatform('Windows'))">zip</UvArchiveExtension>
    <UvArchiveExtension Condition="!$([MSBuild]::IsOSPlatform('Windows'))">tar.gz</UvArchiveExtension>
    <UvZipFileName>uv-$(UvPlatform).$(UvArchiveExtension)</UvZipFileName>
    <UvAssetFolder>$(MSBuildThisFileDirectory)Assets\UV</UvAssetFolder>
    <UvZipPath>$(UvAssetFolder)\$(UvZipFileName)</UvZipPath>
    <UvDownloadUrl>https://github.com/astral-sh/uv/releases/download/$(UvVersion)/$(UvZipFileName)</UvDownloadUrl>
  </PropertyGroup>

  <Target Name="DownloadUv" BeforeTargets="Build"
          Condition="!Exists('$(UvZipPath)') AND '$(UvPlatform)' != '' AND '$(DesignTimeBuild)' != 'true' AND '$(SkipCelbridgeWheelBuild)' != 'true'">
    <Message Text="Downloading uv $(UvVersion) for $(UvPlatform)..." Importance="high" />
    <MakeDir Directories="$(UvAssetFolder)" />
    <DownloadFile SourceUrl="$(UvDownloadUrl)" DestinationFolder="$(UvAssetFolder)" DestinationFileName="$(UvZipFileName)" />
  </Target>

  <!-- Build the celbridge Python wheel from source when Python files change. -->
  <PropertyGroup>
    <PythonPackageFolder>$(MSBuildThisFileDirectory)packages\celbridge</PythonPackageFolder>
    <PythonAssetsFolder>$(MSBuildThisFileDirectory)Assets\Python</PythonAssetsFolder>
    <PythonWheelPath>$(PythonAssetsFolder)\celbridge-0.1.0-py3-none-any.whl</PythonWheelPath>
    <!-- The wheel is built by the uv this project already downloads, so no build depends on a system
         Python. Extracted outside Assets, which ships to the app: the archive belongs there, the
         binaries unpacked from it do not. -->
    <UvBuildFolder>$(MSBuildThisFileDirectory)obj\uv</UvBuildFolder>
    <UvBuildExecutable Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(UvBuildFolder)\uv.exe</UvBuildExecutable>
    <UvBuildExecutable Condition="'$(UvBuildExecutable)' == ''">$(UvBuildFolder)/uv</UvBuildExecutable>
  </PropertyGroup>

  <ItemGroup>
    <PythonSourceFiles Include="$(PythonPackageFolder)\src\celbridge\**\*.py" />
    <PythonSourceFiles Include="$(PythonPackageFolder)\pyproject.toml" />
  </ItemGroup>

  <!-- tar reads both archives uv publishes. The tarball nests its binaries under a folder named after the
       archive, which the Windows zip does not. -->
  <Target Name="ExtractUv" DependsOnTargets="DownloadUv"
          Inputs="$(UvZipPath)" Outputs="$(UvBuildExecutable)"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(SkipCelbridgeWheelBuild)' != 'true'">
    <Error Condition="'$(UvPlatform)' == ''"
           Text="The celbridge wheel is built through uv, and uv publishes no release for this platform, so the wheel cannot be built here." />
    <MakeDir Directories="$(UvBuildFolder)" />
    <Exec Command="tar -xf &quot;$(UvZipPath)&quot; -C &quot;$(UvBuildFolder)&quot;"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <Exec Command="tar -xzf &quot;$(UvZipPath)&quot; --strip-components=1 -C &quot;$(UvBuildFolder)&quot;"
          Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
  </Target>

  <!-- Skipped during design-time builds so editing Python source in Visual Studio does not invoke uv.
       Both conditions repeat on every target in the chain rather than sitting on the two targets that
       hook it into a build, because DependsOnTargets runs a target before the depending target's own
       condition is evaluated. -->
  <Target Name="BuildCelbridgeWheel" DependsOnTargets="ExtractUv"
          Inputs="@(PythonSourceFiles)" Outputs="$(PythonWheelPath)"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(SkipCelbridgeWheelBuild)' != 'true'">
    <Message Text="Building celbridge Python wheel via build.py..." Importance="high" />
    <Exec Command="&quot;$(UvBuildExecutable)&quot; run --no-project --managed-python &quot;$(MSBuildThisFileDirectory)build.py&quot; &quot;$(UvBuildExecutable)&quot;" />
  </Target>

  <!-- The wheel is platform independent and every target framework bundles the same one, so it is built
       once in the outer multi-targeting pass rather than by a nominated framework that the others, which
       build in parallel, would race. -->
  <Target Name="BuildPythonWheelOuter" BeforeTargets="DispatchToInnerBuilds" DependsOnTargets="BuildCelbridgeWheel" />

  <!-- And before content target paths are assigned in an inner build, which is all there is when a head
       references this project for one framework. Up to date by then if the outer pass ran. -->
  <Target Name="BuildPythonWheel" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildCelbridgeWheel" />

  <!-- Include the generated wheel as Content before target paths are assigned, so it enters the Uno
       content pipeline exactly once. -->
  <Target Name="IncludeGeneratedPythonWheel" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildPythonWheel">
    <ItemGroup>
      <Content Include="Assets\Python\*.whl" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Celbridge.Foundation\Celbridge.Foundation.csproj" />
    <ProjectReference Include="..\..\Core\Celbridge.Utilities\Celbridge.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Celbridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\UV\" />
  </ItemGroup>

  <!-- The Uno SDK auto-includes files as Content, which GenerateLibraryLayout bundles into the
       build output. Move Python source files from Content to None so they stay visible in
       Visual Studio for editing but are not bundled (the wheel handles packaging instead). -->
  <ItemGroup>
    <Content Remove="packages\**" />
    <None Include="packages\**"
          Exclude="packages\**\__pycache__\**;packages\**\.venv\**;packages\**\build\**;packages\**\dist\**;packages\**\*.egg-info\**" />
  </ItemGroup>

</Project>
