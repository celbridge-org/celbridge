<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.22621;net10.0-desktop</TargetFrameworks>
    <UnoDisableVSWarnNetIsFirst>true</UnoDisableVSWarnNetIsFirst>
    <UnoSingleProject>true</UnoSingleProject>
    <OutputType>Library</OutputType>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <UnoFeatures>
      CSharpMarkup;
      Lottie;
      Hosting;
      Toolkit;
      Logging;
      Mvvm;
      Configuration;
      Localization;
      ThemeService;
    </UnoFeatures>

    <!-- Suppress PRI249 false-positive warnings caused by Python wheel filenames (e.g. py3-none-any) -->
    <!-- being incorrectly parsed as Windows resource qualifiers by the PRI indexer. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);PRI249</MSBuildWarningsAsMessages>

    <!-- Celbridge.Python.Assets generates the wheel and the uv archive, so neither exists when the SDK
         evaluates the default Assets glob on a clean checkout. Once they do, this keeps the Uno SDK's
         Assets glob on the Skia heads from including them beside IncludeGeneratedPythonAssets. The Windows
         App SDK's Assets glob on the packaged head takes no exclusions, so there an existing asset is
         included by both the glob and the target, as the same file. -->
    <CelbridgeDefaultItemExcludes>$(CelbridgeDefaultItemExcludes);Assets\Python\*.whl;Assets\UV\uv-*.zip;Assets\UV\uv-*.tar.gz</CelbridgeDefaultItemExcludes>

  </PropertyGroup>

  <!-- Both assets are produced by Celbridge.Python.Assets, a single target framework project so that it
       runs once however many of this project's frameworks are building. This target includes them
       whenever the default Assets glob does not: on every head from a clean checkout, and always on the
       Skia heads, where the property group above excludes them. A missing asset is reported here rather
       than at the first console launch, which is where it would otherwise surface. -->
  <Target Name="IncludeGeneratedPythonAssets" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <PythonWheelAsset Include="Assets\Python\*.whl" />
      <UvArchiveAsset Include="Assets\UV\uv-*.zip;Assets\UV\uv-*.tar.gz" />
    </ItemGroup>
    <Error Condition="'@(PythonWheelAsset)' == '' AND '$(SkipPythonAssets)' != 'true' AND '$(DesignTimeBuild)' != 'true'"
           Text="No celbridge wheel in Assets/Python. It is generated by Celbridge.Python.Assets, which did not run or did not succeed." />
    <Error Condition="'@(UvArchiveAsset)' == '' AND '$(SkipPythonAssets)' != 'true' AND '$(DesignTimeBuild)' != 'true'"
           Text="No uv archive in Assets/UV. It is downloaded by Celbridge.Python.Assets, which did not run or did not succeed." />
    <Warning Condition="'$(SkipPythonAssets)' == 'true'"
             Text="Built with SkipPythonAssets, so this output carries no uv archive and no celbridge wheel and cannot run Python." />
    <ItemGroup>
      <Content Include="@(PythonWheelAsset);@(UvArchiveAsset)" />
      <Content Include="Assets\UV\uv_version.txt" Condition="Exists('$(MSBuildThisFileDirectory)Assets\UV\uv_version.txt')" />

      <!-- A .gitignore beside the wheel is not an asset, and the installer would copy it into the support
           folder. It is removed here because the Windows App SDK's Assets glob takes no exclusions. -->
      <Content Remove="Assets\Python\.gitignore" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Celbridge.Foundation\Celbridge.Foundation.csproj" />
    <ProjectReference Include="..\..\Core\Celbridge.Utilities\Celbridge.Utilities.csproj" />
    <!-- UndefineProperties stops a global TargetFramework (e.g. dotnet build -f net10.0-desktop) from
         forcing that framework onto this net10.0 NoTargets project (NETSDK1139). -->
    <ProjectReference Include="..\..\Workspace\Celbridge.Python.Assets\Celbridge.Python.Assets.csproj"
                      ReferenceOutputAssembly="false" UndefineProperties="TargetFramework" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\UV\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Celbridge.Tests" />
  </ItemGroup>

  <!-- The Uno SDK auto-includes files as Content, which GenerateLibraryLayout bundles into the
       build output. Move Python source files from Content to None so they stay visible in
       Visual Studio for editing but are not bundled (the wheel handles packaging instead). -->
  <ItemGroup>
    <Content Remove="packages\**" />
    <None Include="packages\**"
          Exclude="packages\**\__pycache__\**;packages\**\.venv\**;packages\**\build\**;packages\**\dist\**;packages\**\*.egg-info\**" />
  </ItemGroup>

</Project>
