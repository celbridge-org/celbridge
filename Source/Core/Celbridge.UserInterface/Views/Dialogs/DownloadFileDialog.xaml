<ContentDialog
  x:Class="Celbridge.UserInterface.Views.DownloadFileDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="{x:Bind ViewModel.TitleText, Mode=OneWay}"
  PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
  SecondaryButtonText="{x:Bind ViewModel.SecondaryButtonText, Mode=OneWay}"
  DefaultButton="Primary"
  PrimaryButtonClick="Dialog_PrimaryButtonClick"
  SecondaryButtonClick="Dialog_SecondaryButtonClick"
  Closing="Dialog_Closing"
  Opened="Dialog_Opened">

  <!-- Both pages fill the same fixed height, so the dialog's size stays the same on either page. -->
  <Grid Width="480"
        Height="440">

    <!-- The first page saves the file to the download folder. -->
    <StackPanel Spacing="16"
                Visibility="{x:Bind ViewModel.FilePageVisibility, Mode=OneWay}">
      <StackPanel Spacing="2">
        <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{x:Bind ViewModel.SourceText, Mode=OneWay}"
                   Style="{StaticResource SupportingTextStyle}"
                   TextTrimming="CharacterEllipsis"
                   Visibility="{x:Bind ViewModel.SourceVisibility, Mode=OneWay}" />
      </StackPanel>

      <StackPanel Spacing="2">
        <TextBlock Text="{x:Bind ProjectFolderString}"
                   Style="{StaticResource FieldLabelTextStyle}" />

        <Grid ColumnSpacing="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBox x:Name="DownloadFolderTextBox"
                   Grid.Column="0"
                   IsReadOnly="True"
                   IsTabStop="False"
                   Text="{x:Bind ViewModel.DownloadFolderText, Mode=OneWay}"
                   AutomationProperties.Name="{x:Bind ProjectFolderString}" />

          <controls:IconButton x:Name="ChooseFolderButton"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="{x:Bind ChooseFolderString}"
                               ToolTipService.ToolTip="{x:Bind ChooseFolderString}"
                               Click="ChooseFolderButton_Click">
            <controls:Icon IconName="bs-three-dots"
                           FontSize="{StaticResource IconSizeMedium}" />
          </controls:IconButton>
        </Grid>
      </StackPanel>
    </StackPanel>

    <!-- The second page chooses the download folder. -->
    <controls:ResourceSearchListView x:Name="FolderList"
                                     Visibility="{x:Bind ViewModel.FolderPageVisibility, Mode=OneWay}"
                                     ItemInvoked="FolderList_ItemInvoked"
                                     EscapePressed="FolderList_EscapePressed" />
  </Grid>

</ContentDialog>
