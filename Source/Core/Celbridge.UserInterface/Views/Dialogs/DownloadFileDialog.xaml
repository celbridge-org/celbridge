<ContentDialog
  x:Class="Celbridge.UserInterface.Views.DownloadFileDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="{x:Bind ViewModel.TitleText, Mode=OneWay}"
  PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
  SecondaryButtonText="{x:Bind ViewModel.SecondaryButtonText, Mode=OneWay}"
  DefaultButton="Primary"
  PrimaryButtonClick="Dialog_PrimaryButtonClick"
  SecondaryButtonClick="Dialog_SecondaryButtonClick"
  Closing="Dialog_Closing"
  Opened="Dialog_Opened">

  <!-- The dialog takes the height of the page it shows. The first page, seen on every download, has no empty space,
       and the dialog grows while the folder list shows. -->
  <Grid Width="480">

    <!-- The first page saves the file to the download folder, or opens the system save dialog. -->
    <StackPanel Spacing="16"
                Visibility="{x:Bind ViewModel.FilePageVisibility, Mode=OneWay}">
      <StackPanel Spacing="2">
        <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{x:Bind ViewModel.SourceText, Mode=OneWay}"
                   Style="{StaticResource SupportingTextStyle}"
                   TextTrimming="CharacterEllipsis"
                   Visibility="{x:Bind ViewModel.SourceVisibility, Mode=OneWay}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <RadioButton x:Name="InProjectRadioButton"
                     GettingFocus="InProjectRadioButton_GettingFocus"
                     GroupName="DownloadLocation"
                     Content="{x:Bind InProjectString}"
                     IsChecked="{x:Bind ViewModel.IsInProjectSelected, Mode=OneWay}"
                     Checked="InProjectRadioButton_Checked" />

        <!-- Indented to line up with the option's label. -->
        <Grid ColumnSpacing="4"
              Margin="28,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBox x:Name="DownloadFolderTextBox"
                   Grid.Column="0"
                   IsReadOnly="True"
                   IsTabStop="False"
                   Text="{x:Bind ViewModel.DownloadFolderText, Mode=OneWay}"
                   AutomationProperties.Name="{x:Bind InProjectString}" />

          <controls:IconButton x:Name="ChooseFolderButton"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="{x:Bind ChooseFolderString}"
                               ToolTipService.ToolTip="{x:Bind ChooseFolderString}"
                               Click="ChooseFolderButton_Click">
            <controls:Icon IconName="bs-three-dots"
                           FontSize="{StaticResource IconSizeMedium}" />
          </controls:IconButton>
        </Grid>

        <RadioButton x:Name="OtherLocationRadioButton"
                     GroupName="DownloadLocation"
                     Margin="0,8,0,0"
                     IsChecked="{x:Bind ViewModel.IsOtherLocationSelected, Mode=OneWay}"
                     AutomationProperties.Name="{x:Bind OtherLocationString}"
                     AutomationProperties.HelpText="{x:Bind OtherLocationHintString}"
                     Checked="OtherLocationRadioButton_Checked">
          <StackPanel Spacing="2">
            <TextBlock Text="{x:Bind OtherLocationString}" />
            <TextBlock Text="{x:Bind OtherLocationHintString}"
                       Style="{StaticResource SupportingTextStyle}" />
          </StackPanel>
        </RadioButton>
      </StackPanel>
    </StackPanel>

    <!-- The second page chooses the download folder. The folder list has a fixed height, so the page is the same size
         whatever the number of folders in the project. -->
    <controls:ResourceSearchListView x:Name="FolderList"
                                     Height="440"
                                     Visibility="{x:Bind ViewModel.FolderPageVisibility, Mode=OneWay}"
                                     ItemInvoked="FolderList_ItemInvoked"
                                     EscapePressed="FolderList_EscapePressed" />
  </Grid>

</ContentDialog>
