<ContentDialog
  x:Class="Celbridge.UserInterface.Views.AboutDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="{x:Bind TitleString}"
  CloseButtonText="{x:Bind OkString}"
  DefaultButton="Close">

  <StackPanel HorizontalAlignment="Center"
              Spacing="12">
    <Image Source="ms-appx:///Assets/Images/title_icon.png"
           Width="64"
           Height="64"
           AutomationProperties.AccessibilityView="Raw"/>

    <TextBlock Text="{x:Bind ViewModel.VersionText}"
               HorizontalAlignment="Center"
               IsTextSelectionEnabled="True"
               AutomationProperties.AutomationId="about-version-text"/>

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="8">
      <HyperlinkButton Content="{x:Bind WebsiteString}"
                       Click="WebsiteLink_Click"/>
      <HyperlinkButton Content="{x:Bind GitHubString}"
                       Click="GitHubLink_Click"/>
    </StackPanel>
  </StackPanel>

</ContentDialog>
