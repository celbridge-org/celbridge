<ContentDialog
    x:Class="Celbridge.UserInterface.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

  <ContentDialog.Resources>
    <!-- The default caps size a dialog for a prompt, which the settings sections do not fit into. Scoped
         here so the prompts keep the default. Held inside WindowMinimumSize.Authored* with room to spare,
         so the application is still visible around the dialog at the smallest window the user can make. -->
    <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>

    <!-- The height cap leaves more room above the content than the chrome needs at the default text size,
         so a title row and padding grown by the Windows text scale still fit rather than clipping the
         fixed-height content below. -->
    <x:Double x:Key="ContentDialogMaxHeight">620</x:Double>

    <!-- The title row and the content below it are separate parts of the template, so they are held to
         one width here to line their edges up. It sits well inside the cap above, because a row wide
         enough to reach it is clipped at the edge rather than laid out narrower. -->
    <x:Double x:Key="SettingsDialogContentWidth">880</x:Double>

    <!-- Fixed rather than sized to the section, so the dialog does not resize as the user moves down the
         rail. Both extents are held here because they are chosen together against the window minimum. -->
    <x:Double x:Key="SettingsDialogContentHeight">460</x:Double>

  </ContentDialog.Resources>

  <!-- Closing is leaving rather than an action to commit, so it is an X in the title row instead of a
       footer button. Setting no button text collapses the command space. The template left-aligns the
       title, so the row takes the content width to put the button on the same edge as the content. -->
  <ContentDialog.Title>
    <Grid Width="{StaticResource SettingsDialogContentWidth}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock Text="{x:Bind TitleString}"
                 Style="{StaticResource SectionHeadingTextStyle}"
                 VerticalAlignment="Center"/>

      <controls:IconButton x:Name="CloseButton"
                           Grid.Column="1"
                           AutomationProperties.AutomationId="settings-close-button"
                           VerticalAlignment="Center"
                           Click="CloseButton_Click">
        <controls:Icon Symbol="Close"
                       FontSize="{StaticResource IconSizeMedium}"/>
      </controls:IconButton>
    </Grid>
  </ContentDialog.Title>

  <controls:SettingsSectionSwitcher
      Width="{StaticResource SettingsDialogContentWidth}"
      Height="{StaticResource SettingsDialogContentHeight}"
      Sections="{x:Bind ViewModel.Sections, Mode=OneWay}"
      SelectedSection="{x:Bind ViewModel.SelectedSection, Mode=TwoWay}"/>

</ContentDialog>
