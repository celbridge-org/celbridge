<ContentDialog
    x:Class="Celbridge.UserInterface.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
    xmlns:viewmodels="using:Celbridge.UserInterface.ViewModels.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

  <ContentDialog.Resources>
    <!-- The default caps size a dialog for a prompt, which the settings sections do not fit into. Scoped
         here so the prompts keep the default. -->
    <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
    <x:Double x:Key="ContentDialogMaxHeight">720</x:Double>

    <!-- The title row and the content below it are separate parts of the template, so they are held to
         one width here to line their edges up. -->
    <x:Double x:Key="SettingsDialogContentWidth">860</x:Double>
  </ContentDialog.Resources>

  <!-- Closing is leaving rather than an action to commit, so it is an X in the title row instead of a
       footer button. Setting no button text collapses the command space. The template left-aligns the
       title, so the row takes the content width to put the button on the same edge as the content. -->
  <ContentDialog.Title>
    <Grid Width="{StaticResource SettingsDialogContentWidth}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock Text="{x:Bind TitleString}"
                 VerticalAlignment="Center"/>

      <!-- The title row has less horizontal room than the content below it, so the button is inset to
           keep it clear of the dialog edge. -->
      <controls:IconButton x:Name="CloseButton"
                           Grid.Column="1"
                           AutomationProperties.AutomationId="settings-close-button"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Click="CloseButton_Click">
        <controls:Icon Symbol="Close"
                       FontSize="{StaticResource IconSizeMedium}"/>
      </controls:IconButton>
    </Grid>
  </ContentDialog.Title>

  <Grid Width="{StaticResource SettingsDialogContentWidth}"
        Height="520"
        ColumnSpacing="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="180"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <ListView ItemsSource="{x:Bind ViewModel.Sections}"
              SelectedItem="{x:Bind ViewModel.SelectedSection, Mode=TwoWay}"
              SelectionMode="Single">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="viewmodels:SettingsSection">
          <TextBlock Text="{x:Bind Label}"
                     TextWrapping="NoWrap"
                     VerticalAlignment="Center"/>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <Grid Grid.Column="1"
          RowSpacing="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <StackPanel Spacing="4">
        <TextBlock Text="{x:Bind ViewModel.SelectedSection.Label, Mode=OneWay}"
                   Style="{StaticResource SectionHeadingTextStyle}"/>
        <TextBlock Text="{x:Bind ViewModel.SelectedSection.Description, Mode=OneWay}"
                   Style="{StaticResource SupportingTextStyle}"
                   TextWrapping="Wrap"/>
      </StackPanel>

      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled">
        <ContentControl Content="{x:Bind ViewModel.SelectedSection.Content, Mode=OneWay}"
                        HorizontalContentAlignment="Stretch"
                        IsTabStop="False"/>
      </ScrollViewer>
    </Grid>

  </Grid>
</ContentDialog>
