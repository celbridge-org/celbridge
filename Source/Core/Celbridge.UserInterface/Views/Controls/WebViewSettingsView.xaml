<UserControl
    x:Class="Celbridge.UserInterface.Views.WebViewSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
    xmlns:converters="using:Celbridge.UserInterface.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

  <UserControl.Resources>
    <converters:StatusSeverityConverter x:Key="StatusSeverityConverter"/>
  </UserControl.Resources>

  <StackPanel Spacing="24">

    <StackPanel Spacing="8">
      <Button Content="{x:Bind ClearBrowsingDataString}"
              HorizontalAlignment="Left"
              Visibility="{x:Bind ViewModel.IsClearButtonVisible, Mode=OneWay}"
              IsEnabled="{x:Bind ViewModel.IsClearEnabled, Mode=OneWay}"
              Command="{x:Bind ViewModel.BeginClearBrowsingDataCommand}"/>

      <Border Visibility="{x:Bind ViewModel.IsConfirmingClear, Mode=OneWay}"
              Padding="12"
              CornerRadius="4"
              BorderThickness="1"
              BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
        <StackPanel Spacing="12">
          <!-- A Grid rather than a horizontal StackPanel, which measures its children unbounded along its
               own axis so wrapping text never wraps. -->
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <controls:Icon Symbol="Warning"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           VerticalAlignment="Top"/>
            <TextBlock Grid.Column="1"
                       Text="{x:Bind ClearConfirmMessageString}"
                       TextWrapping="Wrap"/>
          </Grid>

          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <Button Content="{x:Bind ClearConfirmButtonString}"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ConfirmClearBrowsingDataCommand}"/>
            <Button Content="{x:Bind CancelString}"
                    Command="{x:Bind ViewModel.CancelClearBrowsingDataCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 TextWrapping="Wrap"
                 Text="{x:Bind ClearBrowsingDataHintString}"/>
    </StackPanel>

    <InfoBar IsOpen="{x:Bind ViewModel.IsStatusVisible, Mode=OneWay}"
             Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay, Converter={StaticResource StatusSeverityConverter}}"
             Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
             IsClosable="False"
             HorizontalAlignment="Left"/>

  </StackPanel>
</UserControl>
