<UserControl
    x:Class="Celbridge.UserInterface.Views.PrivacySettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
    xmlns:converters="using:Celbridge.UserInterface.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Left">

  <UserControl.Resources>
    <converters:StatusSeverityConverter x:Key="StatusSeverityConverter"/>
  </UserControl.Resources>

  <StackPanel Spacing="24"
              HorizontalAlignment="Left">

    <StackPanel Spacing="4">
      <TextBlock FontSize="24"
                 FontWeight="SemiBold"
                 Text="{x:Bind PrivacySectionString}"/>
      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 TextWrapping="Wrap"
                 MaxWidth="784"
                 Text="{x:Bind PrivacyDescriptionString}"/>
    </StackPanel>

    <StackPanel Spacing="8">
      <Button Content="{x:Bind ClearBrowsingDataString}"
              HorizontalAlignment="Left"
              Visibility="{x:Bind ViewModel.IsClearButtonVisible, Mode=OneWay}"
              IsEnabled="{x:Bind ViewModel.IsClearEnabled, Mode=OneWay}"
              Command="{x:Bind ViewModel.BeginClearBrowsingDataCommand}"/>

      <Border Visibility="{x:Bind ViewModel.IsConfirmingClear, Mode=OneWay}"
              MaxWidth="784"
              Padding="12"
              CornerRadius="4"
              BorderThickness="1"
              BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <controls:Icon Symbol="Warning"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           VerticalAlignment="Top"/>
            <TextBlock Text="{x:Bind ClearConfirmMessageString}"
                       TextWrapping="Wrap"
                       MaxWidth="700"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <Button Content="{x:Bind ClearConfirmButtonString}"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ConfirmClearBrowsingDataCommand}"/>
            <Button Content="{x:Bind CancelString}"
                    Command="{x:Bind ViewModel.CancelClearBrowsingDataCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 TextWrapping="Wrap"
                 MaxWidth="784"
                 Text="{x:Bind ClearBrowsingDataHintString}"/>
    </StackPanel>

    <InfoBar IsOpen="{x:Bind ViewModel.IsStatusVisible, Mode=OneWay}"
             Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay, Converter={StaticResource StatusSeverityConverter}}"
             Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
             IsClosable="False"
             MaxWidth="784"
             HorizontalAlignment="Left"/>

  </StackPanel>
</UserControl>
