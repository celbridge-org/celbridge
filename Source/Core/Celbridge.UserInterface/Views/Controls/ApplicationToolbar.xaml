<UserControl
    x:Class="Celbridge.UserInterface.Views.ApplicationToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Celbridge.UserInterface.Views"
    xmlns:services="using:Celbridge.UserInterface.Services">

    <UserControl.Resources>
        <services:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid x:Name="MainGrid"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Top"
          Background="{ThemeResource ChromeBackgroundBrush}">

        <Grid.RowDefinitions>
            <!-- Sized from ToolbarHeight in code-behind, which the window minimum also composes from. -->
            <RowDefinition x:Name="ToolbarRow"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <!-- Sized from WorkspaceConstants in code-behind, so the column spans the utility rail below
                 it and the app icon sits over that rail's buttons. -->
            <ColumnDefinition x:Name="AppIconColumn"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition x:Name="CaptionButtonsColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <Image x:Name="AppIconImage"
               Source="ms-appx:///Assets/Images/title_icon.png"
               Width="{StaticResource AppIconSize}"
               Height="{StaticResource AppIconSize}"
               Margin="0"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />

        <local:ProjectToolbar x:Name="ProjectToolbar"
                                 Grid.Column="1"/>

        <!-- Save Icon - positioned to the left of layout toolbar -->
        <controls:Icon x:Name="SaveIcon"
                       Grid.Column="3"
                       Visibility="{x:Bind ViewModel.IsWorkspaceLoaded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       Opacity="{x:Bind ViewModel.IsSaving, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}"
                       FontSize="{StaticResource IconSizeMedium}"
                       Symbol="Save"/>

        <!-- Layout Toolbar - positioned on the right side of the toolbar -->
        <local:LayoutToolbar x:Name="LayoutToolbar"
                             Grid.Column="4"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Stretch"
                             Margin="0,0,8,0"/>
    </Grid>
</UserControl>
