<UserControl
    x:Name="IconRoot"
    x:Class="Celbridge.UserInterface.Views.PanelIcons.UtilityPanelIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
        <Grid Width="16" Height="16">
            <Rectangle Stroke="{Binding Foreground, ElementName=IconRoot}"
                       StrokeThickness="1.0" 
                       RadiusX="2" RadiusY="2"/>
            <Rectangle x:Name="PanelFill"
                       Width="5" Height="14" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Center"
                       Margin="1,0,0,0"
                       Fill="{Binding Foreground, ElementName=IconRoot}"/>
            <Line x:Name="PanelDivider"
                  X1="6" Y1="1" X2="6" Y2="15"
                  Stroke="{Binding Foreground, ElementName=IconRoot}"
                  StrokeThickness="1.0"
                  Visibility="Collapsed"/>
        </Grid>
    </Viewbox>
</UserControl>
