<UserControl
    x:Name="IconRoot"
    x:Class="Celbridge.UserInterface.Views.PanelIcons.BottomAreaAlignmentIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Viewbox Width="{StaticResource IconSizeMedium}"
             Height="{StaticResource IconSizeMedium}">
        <Grid Width="16" Height="16">
            <Rectangle Stroke="{Binding Foreground, ElementName=IconRoot}"
                       StrokeThickness="1.0"
                       RadiusX="2" RadiusY="2"/>

            <!-- The gutters either side of the Main area. Each one stops at the bar where the Bottom area
                 runs under the surface beyond it, because the two no longer sit side by side there. -->
            <Line x:Name="UtilityPanelGutter"
                  X1="5" Y1="1" X2="5" Y2="15"
                  Stroke="{Binding Foreground, ElementName=IconRoot}"
                  StrokeThickness="1.0"/>
            <Line x:Name="SideAreaGutter"
                  X1="11" Y1="1" X2="11" Y2="15"
                  Stroke="{Binding Foreground, ElementName=IconRoot}"
                  StrokeThickness="1.0"/>

            <!-- The Bottom area. How far it reaches is what the alignment sets. -->
            <Rectangle x:Name="BottomAreaBar"
                       Width="6" Height="5"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="5,0,0,1"
                       Fill="{Binding Foreground, ElementName=IconRoot}"/>
        </Grid>
    </Viewbox>
</UserControl>
