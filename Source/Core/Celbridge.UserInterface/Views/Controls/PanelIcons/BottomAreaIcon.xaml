<UserControl
    x:Name="IconRoot"
    x:Class="Celbridge.UserInterface.Views.PanelIcons.BottomAreaIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Viewbox Width="{StaticResource IconSizeMedium}"
             Height="{StaticResource IconSizeMedium}">
        <Grid Width="16" Height="16">
            <Rectangle Stroke="{Binding Foreground, ElementName=IconRoot}"
                       StrokeThickness="1.0" 
                       RadiusX="2" RadiusY="2"/>
            <Rectangle x:Name="PanelFill"
                       Width="14" Height="5" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,1"
                       Fill="{Binding Foreground, ElementName=IconRoot}"/>
            <Line x:Name="PanelDivider"
                  X1="1" Y1="10" X2="15" Y2="10"
                  Stroke="{Binding Foreground, ElementName=IconRoot}"
                  StrokeThickness="1.0"
                  Visibility="Collapsed"/>
        </Grid>
    </Viewbox>
</UserControl>
