<UserControl
    x:Class="Celbridge.UserInterface.Views.Controls.ResourceIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Celbridge.UserInterface.Views.Controls">

    <Grid VerticalAlignment="Center">
        <!-- A folder keeps the same yellow in both themes. Only a file's icon has its color adjusted to the theme. -->
        <local:Icon x:Name="FolderIcon"
                    Symbol="FolderFilled"
                    FontSize="18"
                    Margin="0"
                    VerticalAlignment="Center"
                    Foreground="#FFCC40"
                    Visibility="Collapsed" />

        <!-- A file shows the icon for its file type. -->
        <local:FileIcon x:Name="FileIconControl"
                        Size="18"
                        MinWidth="22"
                        Margin="0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
    </Grid>
</UserControl>
