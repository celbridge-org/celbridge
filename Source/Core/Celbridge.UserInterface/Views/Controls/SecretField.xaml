<UserControl
  x:Class="Celbridge.UserInterface.Views.Controls.SecretField"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
  xmlns:converters="using:Celbridge.UserInterface.Converters">

  <UserControl.Resources>
    <converters:StatusSeverityConverter x:Key="StatusSeverityConverter"/>
  </UserControl.Resources>

  <StackPanel Spacing="8">
    <Grid>
      <Button Content="{x:Bind SetString}"
              Visibility="{x:Bind ViewModel.IsSetVisible, Mode=OneWay}"
              Command="{x:Bind ViewModel.BeginChangeCommand}"/>

      <StackPanel Orientation="Horizontal"
                  Spacing="12"
                  Visibility="{x:Bind ViewModel.IsStoredVisible, Mode=OneWay}">
        <TextBlock Text="{x:Bind ViewModel.StoredSecretDisplay}"
                   VerticalAlignment="Center"/>
        <Button Content="{x:Bind ChangeString}"
                Command="{x:Bind ViewModel.BeginChangeCommand}"/>
        <Button Content="{x:Bind RemoveString}"
                Command="{x:Bind ViewModel.BeginRemoveCommand}"/>
      </StackPanel>

      <StackPanel Spacing="8"
                  Visibility="{x:Bind ViewModel.IsEditVisible, Mode=OneWay}">
        <PasswordBox x:Name="SecretPasswordBox"
                     PasswordChanged="SecretPasswordBox_PasswordChanged"
                     KeyDown="SecretPasswordBox_KeyDown"/>

        <StackPanel Orientation="Horizontal"
                    Spacing="8">
          <Button Content="{x:Bind SaveString}"
                  Style="{ThemeResource AccentButtonStyle}"
                  IsEnabled="{x:Bind ViewModel.IsSaveEnabled, Mode=OneWay}"
                  Command="{x:Bind ViewModel.SaveCommand}"/>
          <Button Content="{x:Bind CancelString}"
                  Command="{x:Bind ViewModel.CancelChangeCommand}"/>
        </StackPanel>
      </StackPanel>

      <Border Visibility="{x:Bind ViewModel.IsRemoveConfirmVisible, Mode=OneWay}"
              Padding="12"
              CornerRadius="4"
              BorderThickness="1"
              BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
        <StackPanel Spacing="12">
          <!-- A Grid lets the message wrap. A horizontal StackPanel measures its children with unlimited
               width. -->
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <controls:Icon Symbol="Warning"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           VerticalAlignment="Top"/>
            <TextBlock Grid.Column="1"
                       Text="{x:Bind RemoveMessageString}"
                       TextWrapping="Wrap"/>
          </Grid>

          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <Button Content="{x:Bind RemoveString}"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ConfirmRemoveCommand}"/>
            <Button Content="{x:Bind CancelString}"
                    Command="{x:Bind ViewModel.CancelRemoveCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <InfoBar IsOpen="{x:Bind ViewModel.IsStatusVisible, Mode=OneWay}"
             Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay, Converter={StaticResource StatusSeverityConverter}}"
             Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
             IsClosable="False"
             HorizontalAlignment="Left"/>
  </StackPanel>
</UserControl>
