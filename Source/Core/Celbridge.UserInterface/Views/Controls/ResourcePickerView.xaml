<UserControl
  x:Class="Celbridge.UserInterface.Views.Controls.ResourcePickerView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Celbridge.UserInterface.ViewModels.Controls"
  xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Width="{StaticResource ResourcePickerViewWidth}"
  PreviewKeyDown="Root_PreviewKeyDown">

  <!-- The list takes whatever height the dialog gives the control. -->
  <Grid RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Location bar: Up, then the breadcrumb of the current folder, then the search box. While the search box has
         text, a label takes the breadcrumb's place. -->
    <Grid Grid.Row="0"
          ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <controls:IconButton x:Name="UpButton"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           IsEnabled="{x:Bind ViewModel.CanGoUp, Mode=OneWay}"
                           AutomationProperties.Name="{x:Bind UpString}"
                           ToolTipService.ToolTip="{x:Bind UpString}"
                           Click="UpButton_Click">
        <controls:Icon Symbol="ArrowUp"
                       FontSize="{StaticResource IconSizeMedium}"/>
      </controls:IconButton>

      <!-- The project folder's part shows as a folder icon, since a resource key never includes the project's
           name. The project's name is the icon's tooltip and accessible name. -->
      <BreadcrumbBar x:Name="LocationBreadcrumb"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     ItemsSource="{x:Bind ViewModel.Crumbs, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.BreadcrumbVisibility, Mode=OneWay}"
                     ItemClicked="LocationBreadcrumb_ItemClicked">
        <BreadcrumbBar.ItemTemplate>
          <DataTemplate>
            <controls:ResourcePickerCrumbView/>
          </DataTemplate>
        </BreadcrumbBar.ItemTemplate>
      </BreadcrumbBar>

      <TextBlock x:Name="SearchLocationText"
                 Grid.Column="1"
                 VerticalAlignment="Center"
                 Text="{x:Bind SearchLocationString}"
                 TextTrimming="CharacterEllipsis"
                 Visibility="{x:Bind ViewModel.SearchLocationVisibility, Mode=OneWay}"/>

      <TextBox x:Name="SearchTextBox"
               Grid.Column="2"
               VerticalAlignment="Center"
               PlaceholderText="{x:Bind SearchPlaceholderString}"
               AutomationProperties.Name="{x:Bind SearchPlaceholderString}"
               Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               IsSpellCheckEnabled="False"
               AcceptsReturn="False"
               KeyDown="SearchTextBox_KeyDown"/>

      <!-- The caller's extensions, which limit both the folder's listing and the search. -->
      <TextBlock x:Name="ExtensionFilterText"
                 Grid.Column="3"
                 VerticalAlignment="Center"
                 MaxWidth="96"
                 Text="{x:Bind ViewModel.ExtensionFilterText, Mode=OneWay}"
                 TextTrimming="CharacterEllipsis"
                 ToolTipService.ToolTip="{x:Bind ViewModel.ExtensionFilterText, Mode=OneWay}"
                 Style="{StaticResource SupportingTextStyle}"
                 Visibility="{x:Bind ViewModel.ExtensionFilterVisibility, Mode=OneWay}"/>
    </Grid>

    <!-- Code-behind sets the corners from PanelCornerRadius. That resource is a Double. XAML can't assign a Double
         to CornerRadius. -->
    <Border x:Name="ListArea"
            Grid.Row="1"
            Padding="6"
            Background="{ThemeResource ContentBackgroundBrush}"
            BorderBrush="{ThemeResource PanelEdgeBrush}"
            BorderThickness="1">

      <!-- The current folder's contents, or the search's matches -->
      <ListView x:Name="ResourceList"
                ItemsSource="{x:Bind ViewModel.ShownItems, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                SelectionMode="Single"
                IsDoubleTapEnabled="True"
                DoubleTapped="ResourceList_DoubleTapped"
                PreviewKeyDown="ResourceList_PreviewKeyDown">
        <!-- UNO-BUG: the Skia heads' virtualizing panel misjudges the list's height. Scrolling a row into view then
             pushes the first rows out of a list short enough to show them all. So the list uses a plain StackPanel. -->
        <ListView.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel VerticalAlignment="Top"/>
          </ItemsPanelTemplate>
        </ListView.ItemsPanel>
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                  <Grid x:Name="ContentGrid"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent">
                    <ContentPresenter/>

                    <VisualStateManager.VisualStateGroups>
                      <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>

                        <VisualState x:Name="PointerOver">
                          <VisualState.Setters>
                            <Setter Target="ContentGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                          </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="Pressed">
                          <VisualState.Setters>
                            <Setter Target="ContentGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                          </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="Selected">
                          <VisualState.Setters>
                            <Setter Target="ContentGrid.Background" Value="{ThemeResource SelectionBackgroundBrush}"/>
                          </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="SelectedPointerOver">
                          <VisualState.Setters>
                            <Setter Target="ContentGrid.Background" Value="{ThemeResource SelectionBackgroundBrush}"/>
                          </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="SelectedPressed">
                          <VisualState.Setters>
                            <Setter Target="ContentGrid.Background" Value="{ThemeResource SelectionBackgroundBrush}"/>
                          </VisualState.Setters>
                        </VisualState>
                      </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                  </Grid>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="vm:ResourcePickerItem">
            <Grid MinHeight="32"
                  Padding="4,0,0,0"
                  ToolTipService.ToolTip="{x:Bind TooltipText}"
                  AutomationProperties.HelpText="{x:Bind ReadOnlyMessage}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- The icon dims with the name when the resource is read-only or hidden. -->
              <controls:FileIcon Grid.Column="0"
                                 Size="18"
                                 IconDefinition="{x:Bind IconDefinition}"
                                 Opacity="{x:Bind IsDimmed, Converter={StaticResource BoolToDimmedOpacityConverter}, ConverterParameter=Inverted}"
                                 VerticalAlignment="Center"/>

              <!-- The minimum width lines up the search results' paths in a column. A longer name pushes its path
                   to the right. -->
              <TextBlock Grid.Column="1"
                         Text="{x:Bind Name}"
                         MinWidth="200"
                         Opacity="{x:Bind IsDimmed, Converter={StaticResource BoolToDimmedOpacityConverter}, ConverterParameter=Inverted}"
                         VerticalAlignment="Center"
                         Margin="8,0,0,0"
                         TextTrimming="CharacterEllipsis"/>

              <!-- A search result's full path. The Search panel marks a match in semibold, and so does the picker.
                   The match also takes the primary text color, so it stands out from the rest of the path without
                   relying on a hue. The runs sit on one line, since a line break between runs would show as a
                   space. -->
              <TextBlock Grid.Column="2"
                         Visibility="{x:Bind PathVisibility}"
                         Style="{StaticResource SupportingTextStyle}"
                         VerticalAlignment="Center"
                         Margin="12,0,8,0"
                         TextTrimming="CharacterEllipsis"><Run Text="{x:Bind MarkedPath.Before}"/><Run Text="{x:Bind MarkedPath.Mark}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/><Run Text="{x:Bind MarkedPath.After}"/></TextBlock>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>

    <!-- Shown over the empty list while the project is walked for the search -->
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
      <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Width="16"
                    Height="16"/>
      <TextBlock Text="{x:Bind LoadingString}"
                 Style="{StaticResource SupportingTextStyle}"
                 VerticalAlignment="Center"/>
    </StackPanel>

    <!-- How many items the list leaves out -->
    <TextBlock Grid.Row="2"
               Text="{x:Bind ViewModel.MoreItemsText, Mode=OneWay}"
               Style="{StaticResource SupportingTextStyle}"
               Visibility="{x:Bind ViewModel.MoreItemsVisibility, Mode=OneWay}"/>

    <!-- The name of the file to save, in save mode. Under the field, an error says why the name can't be used, and a
         question asks before replacing a file. -->
    <StackPanel Grid.Row="3"
                Visibility="{x:Bind ViewModel.NameFieldVisibility, Mode=OneWay}">
      <TextBox x:Name="NameTextBox"
               Header="{x:Bind NameString}"
               HeaderTemplate="{StaticResource FieldHeaderTemplate}"
               Text="{x:Bind ViewModel.NameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               IsSpellCheckEnabled="False"
               AcceptsReturn="False"
               KeyDown="NameTextBox_KeyDown"
               TextChanged="NameTextBox_TextChanged"/>
      <Grid MinHeight="56"
            Margin="0,8,0,0">
        <InfoBar Severity="Error"
                 IsOpen="{x:Bind ViewModel.IsNameErrorVisible, Mode=OneWay}"
                 IsClosable="False"
                 Message="{x:Bind ViewModel.NameErrorText, Mode=OneWay}"/>
        <InfoBar Severity="Warning"
                 IsOpen="{x:Bind ViewModel.IsAskingToReplace, Mode=OneWay}"
                 IsClosable="False"
                 Message="{x:Bind ViewModel.ReplaceQuestionText, Mode=OneWay}"/>
      </Grid>
    </StackPanel>
  </Grid>

</UserControl>
