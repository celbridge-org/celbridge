<UserControl
    x:Class="Celbridge.UserInterface.Views.Controls.SettingsSectionSwitcher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

  <!-- The rail sits on the chrome surface and the section is carved out of it, the same way a panel is
       carved out of the workspace, with the gutter as the channel between them. -->
  <Grid ColumnSpacing="{StaticResource GutterSize}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="150"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- The top padding drops the first row onto the section heading's line: it is the heading band's
         inset less half the difference between a row's height and its text. Retune it if any of those
         three change. -->
    <ItemsControl x:Name="RailItems"
                  Padding="0,10,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="controls:SettingsSection">
          <controls:IconToggleButton Style="{StaticResource RailButtonStyle}"
                                     Margin="0,0,0,2"
                                     IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                     Click="RailButton_Click">
            <StackPanel Orientation="Horizontal"
                        Spacing="10">
              <controls:Icon IconName="{x:Bind IconName}"
                             FontSize="{StaticResource IconSizeMedium}"
                             VerticalAlignment="Center"/>
              <TextBlock Text="{x:Bind Label}"
                         TextWrapping="NoWrap"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </controls:IconToggleButton>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Corners are set in code-behind from PanelCornerRadius, which is a Double. -->
    <Border x:Name="SectionArea"
            Grid.Column="1"
            Background="{ThemeResource ContentBackgroundBrush}"
            BorderBrush="{ThemeResource PanelEdgeBrush}"
            BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="{ThemeResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="16">
          <StackPanel Spacing="2">
            <TextBlock x:Name="SectionLabel"
                       Style="{StaticResource SectionHeadingTextStyle}"/>
            <TextBlock x:Name="SectionDescription"
                       Style="{StaticResource SupportingTextStyle}"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- Every section is realized here and hidden rather than swapped in, so its scroll position and
             expander state survive navigating away and back. -->
        <Grid x:Name="SectionContent"
              Grid.Row="1"/>

      </Grid>
    </Border>

  </Grid>
</UserControl>
