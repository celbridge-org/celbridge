<UserControl
  x:Class="Celbridge.UserInterface.Views.Controls.IconPickerField"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Celbridge.UserInterface.Views.Controls">

  <StackPanel Spacing="2">
    <TextBlock Text="{x:Bind LabelString}"
               Style="{StaticResource FieldLabelTextStyle}" />

    <Grid ColumnSpacing="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- The glyph the surface will draw for what the field currently holds, which is the default icon
           while the field is empty. -->
      <controls:Icon x:Name="PreviewIcon"
                     Grid.Column="0"
                     Width="20"
                     FontSize="{StaticResource IconSizeMedium}"
                     VerticalAlignment="Center" />

      <TextBox x:Name="IconTextBox"
               Grid.Column="1"
               IsSpellCheckEnabled="False"
               PlaceholderText="{x:Bind PlaceholderString}"
               Text="{x:Bind IconName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
               KeyDown="IconTextBox_KeyDown" />

      <controls:IconButton Grid.Column="2"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="{x:Bind BrowseTooltipString}"
                           ToolTipService.ToolTip="{x:Bind BrowseTooltipString}"
                           Click="BrowseButton_Click">
        <controls:Icon IconName="bs-three-dots" FontSize="{StaticResource IconSizeMedium}" />
      </controls:IconButton>
    </Grid>

    <TextBlock Text="{x:Bind HintString}"
               Style="{StaticResource SupportingTextStyle}"
               TextWrapping="Wrap" />

    <TextBlock x:Name="UnknownIconWarning"
               Text="{x:Bind UnknownIconString}"
               Style="{StaticResource SupportingTextStyle}"
               Foreground="{ThemeResource SystemFillColorCautionBrush}"
               TextWrapping="Wrap"
               Visibility="Collapsed" />
  </StackPanel>
</UserControl>
