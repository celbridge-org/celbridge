<UserControl
    x:Class="Celbridge.UserInterface.Views.PageNavigationToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Celbridge.UserInterface.Services">

    <UserControl.Resources>
        <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="TitleBarSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="4,0,4,0"/>
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        </Style>
    </UserControl.Resources>

  <StackPanel Orientation="Horizontal"
              VerticalAlignment="Stretch">

    <!-- Main menu launcher. Its flyout is populated by MainMenu on platforms without a native menu bar, and the
         button is shown from code-behind on those platforms; macOS surfaces these commands through the system
         menu bar, so the button stays collapsed there. -->
    <Button x:Name="MainMenuButton"
            AutomationProperties.AutomationId="main-menu-button"
            Background="Transparent"
            BorderThickness="0"
            Padding="10,8"
            VerticalAlignment="Stretch"
            Visibility="Collapsed">
      <controls:Icon Symbol="Menu"
                     FontSize="{StaticResource IconSizeMedium}"/>
      <Button.Flyout>
        <MenuFlyout x:Name="MainMenuFlyout"
                    Placement="BottomEdgeAlignedLeft"/>
      </Button.Flyout>
    </Button>

    <NavigationView x:Name="PageNavigation"
                    IsPaneToggleButtonVisible="False"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    PaneDisplayMode="Top"
                    Background="Transparent"
                    SelectionChanged="PageNavigation_SelectionChanged">

        <NavigationView.MenuItems>
            <!-- Main Menu is added programmatically -->

            <!-- The page glyphs sit in the item Content rather than the Icon slot: the Icon slot renders inside
                 the presenter's IconBox Viewbox, which scales to a fixed box and ignores FontSize, so Content is
                 the only place the shared command icon size takes effect in top mode. -->

            <!-- Home -->
            <NavigationViewItem x:Name="HomeNavItem"
                                AutomationProperties.AutomationId="home-button"
                                Tag="Home">
                <controls:Icon Symbol="Home"
                               FontSize="{StaticResource IconSizeMedium}"/>
            </NavigationViewItem>

            <!-- Community -->
            <NavigationViewItem x:Name="CommunityNavItem"
                                AutomationProperties.AutomationId="community-button"
                                Tag="Community">
                <controls:Icon Symbol="People"
                               FontSize="{StaticResource IconSizeMedium}"/>
            </NavigationViewItem>

            <!-- Separator before Workspace -->
            <NavigationViewItemSeparator x:Name="WorkspaceSeparator"
                                         Visibility="{x:Bind ViewModel.IsWorkspaceLoaded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Workspace - shows project name when loaded -->
            <NavigationViewItem x:Name="WorkspaceNavItem"
                                AutomationProperties.AutomationId="workspace-button"
                                Tag="Workspace"
                                Visibility="{x:Bind ViewModel.IsWorkspaceLoaded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <controls:Icon Symbol="Folder"
                                   FontSize="{StaticResource IconSizeMedium}"/>
                    <TextBlock Text="{x:Bind ViewModel.ProjectTitle, Mode=OneWay}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <!-- Shortcut buttons to the right of the project button -->
        <NavigationView.PaneCustomContent>
            <StackPanel x:Name="PaneButtonsContainer"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">

              <!-- Shortcut buttons (added programmatically) -->
              <Border x:Name="ShortcutLeadingSeparator"
                      Style="{StaticResource TitleBarSeparatorStyle}"
                      Visibility="Collapsed"/>

              <StackPanel x:Name="ShortcutButtonsPanel"
                          Orientation="Horizontal"/>

            </StackPanel>
        </NavigationView.PaneCustomContent>
    </NavigationView>

  </StackPanel>
</UserControl>
