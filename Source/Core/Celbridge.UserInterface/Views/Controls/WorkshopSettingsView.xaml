<UserControl
    x:Class="Celbridge.UserInterface.Views.WorkshopSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
    xmlns:converters="using:Celbridge.UserInterface.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Left">

  <UserControl.Resources>
    <converters:StatusSeverityConverter x:Key="StatusSeverityConverter"/>
  </UserControl.Resources>

  <StackPanel Spacing="24"
              HorizontalAlignment="Left">

    <StackPanel Spacing="4">
      <TextBlock FontSize="24"
                 FontWeight="SemiBold"
                 Text="{x:Bind WorkshopSectionString}"/>
      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 TextWrapping="Wrap"
                 MaxWidth="784"
                 Text="{x:Bind WorkshopDescriptionString}"/>
    </StackPanel>

    <ContentControl IsEnabled="{x:Bind ViewModel.IsStoreAvailable, Mode=OneWay}"
                    IsTabStop="False">
      <Grid ColumnSpacing="24"
            RowSpacing="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="160"/>
          <ColumnDefinition Width="600"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="{x:Bind AuthorString}"
                   VerticalAlignment="Center"/>

        <TextBox x:Name="AuthorTextBox"
                 Grid.Column="1"
                 Text="{x:Bind ViewModel.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 IsSpellCheckEnabled="False"
                 PlaceholderText="{x:Bind AuthorPlaceholderString}"
                 ToolTipService.ToolTip="{x:Bind AuthorTooltipString}"/>

        <TextBlock Grid.Row="1"
                   Text="{x:Bind WorkshopUrlString}"
                   VerticalAlignment="Center"/>

        <TextBox x:Name="WorkshopUrlTextBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Text="{x:Bind ViewModel.WorkshopUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 IsSpellCheckEnabled="False"
                 PlaceholderText="https://"
                 ToolTipService.ToolTip="{x:Bind WorkshopUrlTooltipString}"/>

        <TextBlock Grid.Row="2"
                   Text="{x:Bind WorkshopKeyString}"
                   VerticalAlignment="Center"/>

        <Grid Grid.Row="2"
              Grid.Column="1">
          <Button Content="{x:Bind SetWorkshopKeyString}"
                  Visibility="{x:Bind ViewModel.IsSetKeyVisible, Mode=OneWay}"
                  Command="{x:Bind ViewModel.BeginChangeWorkshopKeyCommand}"/>

          <StackPanel Orientation="Horizontal"
                      Spacing="12"
                      Visibility="{x:Bind ViewModel.IsStoredKeyVisible, Mode=OneWay}">
            <TextBlock Text="{x:Bind ViewModel.StoredKeyDisplay, Mode=OneWay}"
                       VerticalAlignment="Center"/>
            <Button Content="{x:Bind ChangeKeyString}"
                    Command="{x:Bind ViewModel.BeginChangeWorkshopKeyCommand}"/>
            <Button Content="{x:Bind RemoveKeyString}"
                    Command="{x:Bind ViewModel.BeginRemoveWorkshopKeyCommand}"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      Visibility="{x:Bind ViewModel.IsKeyEditVisible, Mode=OneWay}">
            <PasswordBox x:Name="WorkshopKeyPasswordBox"
                         Width="360"
                         VerticalAlignment="Center"
                         PasswordChanged="WorkshopKeyPasswordBox_PasswordChanged"
                         KeyDown="WorkshopKeyPasswordBox_KeyDown"
                         ToolTipService.ToolTip="{x:Bind KeyTooltipString}"/>
            <Button Content="{x:Bind SaveKeyString}"
                    Style="{ThemeResource AccentButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.IsSaveKeyEnabled, Mode=OneWay}"
                    Command="{x:Bind ViewModel.SaveWorkshopKeyCommand}"/>
            <Button Content="{x:Bind CancelString}"
                    Command="{x:Bind ViewModel.CancelChangeWorkshopKeyCommand}"/>
          </StackPanel>

          <Border Visibility="{x:Bind ViewModel.IsRemoveConfirmVisible, Mode=OneWay}"
                  Padding="12"
                  CornerRadius="4"
                  BorderThickness="1"
                  BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                  Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <controls:Icon Symbol="Warning"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               VerticalAlignment="Top"/>
                <TextBlock Text="{x:Bind KeyRemoveMessageString}"
                           TextWrapping="Wrap"
                           MaxWidth="520"/>
              </StackPanel>

              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <Button Content="{x:Bind RemoveKeyString}"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.ConfirmRemoveWorkshopKeyCommand}"/>
                <Button Content="{x:Bind CancelString}"
                        Command="{x:Bind ViewModel.CancelRemoveWorkshopKeyCommand}"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </ContentControl>

    <Button Content="{x:Bind TestConnectionString}"
            HorizontalAlignment="Left"
            IsEnabled="{x:Bind ViewModel.IsStoreAvailable, Mode=OneWay}"
            Command="{x:Bind ViewModel.TestConnectionCommand}"/>

    <InfoBar IsOpen="{x:Bind ViewModel.IsStatusVisible, Mode=OneWay}"
             Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay, Converter={StaticResource StatusSeverityConverter}}"
             Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
             IsClosable="False"
             MaxWidth="784"
             HorizontalAlignment="Left"/>

  </StackPanel>
</UserControl>
