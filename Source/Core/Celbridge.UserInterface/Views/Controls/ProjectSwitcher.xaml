<UserControl
    x:Class="Celbridge.UserInterface.Views.ProjectSwitcher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Celbridge.UserInterface.Services"
    xmlns:ui="using:Celbridge.UserInterface">

    <UserControl.Resources>
        <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

  <!-- A custom button styled as a prominent, distinct control rather than a nav tab. Clicking it navigates to
       the workspace; the nested chevron button opens the recent-projects switcher, its Tapped handled so it
       never triggers the navigation click. -->
  <Button x:Name="WorkspaceButton"
          AutomationProperties.AutomationId="workspace-button"
          Click="WorkspaceButton_Click"
          ui:FocusTracking.PreservePanelFocus="True"
          Background="{ThemeResource NavigationViewItemBackgroundPointerOver}"
          BorderThickness="0"
          CornerRadius="4"
          Padding="8,0,0,0"
          VerticalAlignment="Center"
          VerticalContentAlignment="Stretch"
          Visibility="{x:Bind ViewModel.IsWorkspaceLoaded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

    <!-- Attached to the whole button (not the chevron) so it drops down aligned to the button's left edge.
         Every item after the recent projects header is rebuilt each time the menu opens. -->
    <FlyoutBase.AttachedFlyout>
      <MenuFlyout x:Name="ProjectMenuFlyout"
                  Placement="BottomEdgeAlignedLeft">

        <MenuFlyoutItem Text="{x:Bind NewProjectString}"
                        Click="NewProject">
          <MenuFlyoutItem.Icon>
            <controls:Icon Symbol="FolderAdd"/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>

        <MenuFlyoutItem Text="{x:Bind OpenProjectString}"
                        Click="OpenProject">
          <MenuFlyoutItem.Icon>
            <controls:Icon Symbol="FolderOpen"/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>

        <MenuFlyoutItem Text="{x:Bind ReloadProjectString}"
                        Click="ReloadProject">
          <MenuFlyoutItem.Icon>
            <controls:Icon Symbol="Refresh"/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>

        <MenuFlyoutItem Text="{x:Bind CloseProjectString}"
                        Click="CloseProject">
          <MenuFlyoutItem.Icon>
            <controls:Icon Symbol="Close"/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>

        <MenuFlyoutSeparator x:Name="CurrentProjectSeparator"/>

        <controls:MenuSectionHeaderItem x:Name="CurrentProjectHeader"
                                        Text="{x:Bind CurrentProjectHeaderString}"
                                        Style="{StaticResource MenuSectionHeaderItemStyle}"/>

        <controls:ProjectMenuItem x:Name="CurrentProjectItem"
                                  Style="{StaticResource ProjectMenuItemStyle}"
                                  Click="ReturnToCurrentProject"/>

        <!-- The deliberate route back to the load report, in every state including a healthy one. Named
             for what it does: the health itself is stated by the button beside the switcher. -->
        <MenuFlyoutItem x:Name="ProjectHealthItem"
                        Click="OpenProjectHealthReport">
          <MenuFlyoutItem.Icon>
            <controls:Icon x:Name="ProjectHealthIcon"/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>

        <MenuFlyoutSeparator/>

        <controls:MenuSectionHeaderItem Text="{x:Bind RecentProjectsHeaderString}"
                                        Style="{StaticResource MenuSectionHeaderItemStyle}"/>
      </MenuFlyout>
    </FlyoutBase.AttachedFlyout>

    <!-- Sized to a utility rail button, which the button takes as its own height. -->
    <Grid Height="32">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Project avatar and name, so the button carries the same identity as the menu rows. Clicking this
           area navigates to the workspace. -->
      <StackPanel Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="8"
                  VerticalAlignment="Center">
        <!-- A filled tile reads larger than a line glyph on the same box, so it sits a step under the
             command icon size beside it. -->
        <controls:ProjectAvatar ProjectName="{x:Bind ViewModel.ProjectTitle, Mode=OneWay}"
                                Size="18"
                                VerticalAlignment="Center"/>
        <TextBlock Text="{x:Bind ViewModel.ProjectTitle, Mode=OneWay}"
                   VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Project menu chevron. Fills the right of the button (full height, out to the right edge)
           so the whole right side is an easy target for opening the menu. Its Tapped is handled so
           it never triggers the button's navigation. -->
      <Button x:Name="ProjectMenuButton"
              Grid.Column="1"
              AutomationProperties.AutomationId="project-menu-button"
              Background="Transparent"
              BorderThickness="0"
              Padding="6,0,8,0"
              VerticalAlignment="Stretch"
              Tapped="ProjectMenuButton_Tapped">
        <controls:Icon Symbol="ChevronDown"
                       FontSize="12"
                       VerticalAlignment="Center"/>
      </Button>
    </Grid>
  </Button>
</UserControl>
