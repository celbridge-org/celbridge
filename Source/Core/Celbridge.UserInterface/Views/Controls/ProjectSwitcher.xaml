<UserControl
    x:Class="Celbridge.UserInterface.Views.ProjectSwitcher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Celbridge.UserInterface.Services"
    xmlns:ui="using:Celbridge.UserInterface">

    <UserControl.Resources>
        <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

  <!-- A custom button styled as a prominent, distinct control rather than a nav tab. Clicking anywhere on it
       opens the project menu. It rests on the tone a button takes under the pointer, which is what lifts it
       off the chrome it sits on. -->
  <Button x:Name="WorkspaceButton"
          AutomationProperties.AutomationId="workspace-button"
          Click="WorkspaceButton_Click"
          Background="{ThemeResource ButtonHoverBackgroundBrush}"
          BorderThickness="0"
          CornerRadius="4"
          Padding="8,0,0,0"
          VerticalAlignment="Center"
          VerticalContentAlignment="Stretch"
          Visibility="{x:Bind ViewModel.IsWorkspaceLoaded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

    <!-- Attached to the whole button so it drops down aligned to the button's left edge. The projects the
         menu switches to lead it, and the less frequently used items follow. The recent project rows are the
         only items built at runtime, inserted below the recent projects header each time the menu opens. -->
    <FlyoutBase.AttachedFlyout>
      <MenuFlyout x:Name="ProjectMenuFlyout"
                  Placement="BottomEdgeAlignedLeft">

        <controls:MenuSectionHeaderItem x:Name="CurrentProjectHeader"
                                        Text="{x:Bind CurrentProjectHeaderString}"
                                        Style="{StaticResource MenuSectionHeaderItemStyle}"/>

        <controls:ProjectMenuItem x:Name="CurrentProjectItem"
                                  Style="{StaticResource ProjectMenuItemStyle}"
                                  Click="ReturnToCurrentProject"/>

        <MenuFlyoutSeparator x:Name="CurrentProjectSeparator"/>

        <controls:MenuSectionHeaderItem x:Name="RecentProjectsHeader"
                                        Text="{x:Bind RecentProjectsHeaderString}"
                                        Style="{StaticResource MenuSectionHeaderItemStyle}"/>

        <MenuFlyoutSeparator/>

        <!-- The same four commands the File menu carries, in the same order, so the two surfaces read alike. -->
        <MenuFlyoutItem Text="{x:Bind NewProjectString}"
                        Click="NewProject">
          <MenuFlyoutItem.Icon>
            <controls:Icon Symbol="FolderAdd"/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>

        <MenuFlyoutItem Text="{x:Bind OpenProjectString}"
                        Click="OpenProject">
          <MenuFlyoutItem.Icon>
            <controls:Icon Symbol="FolderOpen"/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>

        <MenuFlyoutItem Text="{x:Bind ReloadProjectString}"
                        Click="ReloadProject">
          <MenuFlyoutItem.Icon>
            <controls:Icon Symbol="Refresh"/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>

        <MenuFlyoutItem Text="{x:Bind CloseProjectString}"
                        Click="CloseProject">
          <MenuFlyoutItem.Icon>
            <controls:Icon Symbol="Close"/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>

        <MenuFlyoutSeparator x:Name="ProjectLoadReportSeparator"/>

        <!-- The only route to the report after a clean load: the health button beside the switcher stays
             collapsed, and the logs: root the report is written to is not enumerated in the Explorer. -->
        <MenuFlyoutItem x:Name="ProjectLoadReportItem"
                        Text="{x:Bind ProjectLoadReportString}"
                        Click="OpenProjectLoadReport">
          <MenuFlyoutItem.Icon>
            <controls:Icon Symbol="Report"/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
      </MenuFlyout>
    </FlyoutBase.AttachedFlyout>

    <!-- Sized to a utility rail button, which the button takes as its own height. -->
    <Grid Height="32">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Project avatar and name, so the button carries the same identity as the menu rows. -->
      <StackPanel Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="8"
                  VerticalAlignment="Center">
        <!-- A filled tile reads larger than a line glyph on the same box, so it sits a step under the
             command icon size beside it. -->
        <controls:ProjectAvatar ProjectName="{x:Bind ViewModel.ProjectTitle, Mode=OneWay}"
                                Size="18"
                                VerticalAlignment="Center"/>
        <TextBlock Text="{x:Bind ViewModel.ProjectTitle, Mode=OneWay}"
                   VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Part of the button rather than a target of its own. -->
      <controls:Icon Grid.Column="1"
                     Symbol="ChevronDown"
                     FontSize="12"
                     Margin="6,0,8,0"
                     VerticalAlignment="Center"/>
    </Grid>
  </Button>
</UserControl>
