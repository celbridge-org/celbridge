<UserControl
    x:Class="Celbridge.UserInterface.Views.ProjectSwitcher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Celbridge.UserInterface.Services"
    xmlns:ui="using:Celbridge.UserInterface">

    <UserControl.Resources>
        <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

  <!-- A custom button styled as a prominent, distinct control rather than a nav tab. Clicking anywhere on it
       opens the project menu. -->
  <Button x:Name="WorkspaceButton"
          AutomationProperties.AutomationId="workspace-button"
          Click="WorkspaceButton_Click"
          Background="{ThemeResource NavigationViewItemBackgroundPointerOver}"
          BorderThickness="0"
          CornerRadius="4"
          Padding="8,0,0,0"
          VerticalAlignment="Center"
          VerticalContentAlignment="Stretch"
          Visibility="{x:Bind ViewModel.IsWorkspaceLoaded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

    <!-- Attached to the whole button so it drops down aligned to the button's left edge. Every item after
         the recent projects header is rebuilt each time the menu opens. -->
    <FlyoutBase.AttachedFlyout>
      <MenuFlyout x:Name="ProjectMenuFlyout"
                  Placement="BottomEdgeAlignedLeft">

        <MenuFlyoutItem Text="{x:Bind NewProjectString}"
                        Click="NewProject">
          <MenuFlyoutItem.Icon>
            <controls:Icon Symbol="FolderAdd"/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>

        <MenuFlyoutItem Text="{x:Bind OpenProjectString}"
                        Click="OpenProject">
          <MenuFlyoutItem.Icon>
            <controls:Icon Symbol="FolderOpen"/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>

        <MenuFlyoutItem Text="{x:Bind ReloadProjectString}"
                        Click="ReloadProject">
          <MenuFlyoutItem.Icon>
            <controls:Icon Symbol="Refresh"/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>

        <MenuFlyoutItem Text="{x:Bind CloseProjectString}"
                        Click="CloseProject">
          <MenuFlyoutItem.Icon>
            <controls:Icon Symbol="Close"/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>

        <MenuFlyoutSeparator x:Name="CurrentProjectSeparator"/>

        <controls:MenuSectionHeaderItem x:Name="CurrentProjectHeader"
                                        Text="{x:Bind CurrentProjectHeaderString}"
                                        Style="{StaticResource MenuSectionHeaderItemStyle}"/>

        <controls:ProjectMenuItem x:Name="CurrentProjectItem"
                                  Style="{StaticResource ProjectMenuItemStyle}"
                                  Click="ReturnToCurrentProject"/>

        <!-- The deliberate route back to the load report, in every state including a healthy one. Named
             for what it does: the health itself is stated by the button beside the switcher. -->
        <MenuFlyoutItem x:Name="ProjectHealthItem"
                        Click="OpenProjectHealthReport">
          <MenuFlyoutItem.Icon>
            <controls:Icon x:Name="ProjectHealthIcon"/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>

        <MenuFlyoutSeparator/>

        <controls:MenuSectionHeaderItem Text="{x:Bind RecentProjectsHeaderString}"
                                        Style="{StaticResource MenuSectionHeaderItemStyle}"/>
      </MenuFlyout>
    </FlyoutBase.AttachedFlyout>

    <!-- Sized to a utility rail button, which the button takes as its own height. -->
    <Grid Height="32">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Project avatar and name, so the button carries the same identity as the menu rows. -->
      <StackPanel Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="8"
                  VerticalAlignment="Center">
        <!-- A filled tile reads larger than a line glyph on the same box, so it sits a step under the
             command icon size beside it. -->
        <controls:ProjectAvatar ProjectName="{x:Bind ViewModel.ProjectTitle, Mode=OneWay}"
                                Size="18"
                                VerticalAlignment="Center"/>
        <TextBlock Text="{x:Bind ViewModel.ProjectTitle, Mode=OneWay}"
                   VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Part of the button rather than a target of its own. -->
      <controls:Icon Grid.Column="1"
                     Symbol="ChevronDown"
                     FontSize="12"
                     Margin="6,0,8,0"
                     VerticalAlignment="Center"/>
    </Grid>
  </Button>
</UserControl>
