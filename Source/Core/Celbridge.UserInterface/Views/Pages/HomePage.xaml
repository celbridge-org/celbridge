<Page
    x:Class="Celbridge.UserInterface.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
    xmlns:local="using:Celbridge.UserInterface.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Grid>
    
    <Grid.RowDefinitions>
      <RowDefinition Height="60"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="30"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="30"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="100"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Start section -->
    <StackPanel Grid.Row="1"
                Grid.Column="1">
      <TextBlock Text="{x:Bind StartString}"
                 FontSize="18"
                 Margin="0,0,0,12"/>

      <HyperlinkButton Foreground="{ThemeResource SystemAccentColor}"
                       Command="{x:Bind ViewModel.NewProjectCommand}"
                       ToolTipService.ToolTip="{x:Bind NewProjectTooltipString}">
        <StackPanel Orientation="Horizontal">
          <controls:Icon Symbol="FolderAdd"/>
          <TextBlock Margin="8 0 0 0"
                     Text="{x:Bind NewProjectString}"/>
        </StackPanel>
      </HyperlinkButton>

      <HyperlinkButton Foreground="{ThemeResource SystemAccentColor}"
                       Command="{x:Bind ViewModel.OpenProjectCommand}"
                       ToolTipService.ToolTip="{x:Bind OpenProjectTooltipString}">
        <StackPanel Orientation="Horizontal">
          <controls:Icon Symbol="FolderOpen"/>
          <TextBlock Margin="8 0 0 0"
                     Text="{x:Bind OpenProjectString}"/>
        </StackPanel>
      </HyperlinkButton>

    </StackPanel>

    <!-- Community section. The workspace reaches these pages from the Utility Panel rail, so this is where
         they are available with no project loaded. -->
    <StackPanel Grid.Row="3"
                Grid.Column="1">
      <TextBlock Text="{x:Bind CommunityString}"
                 FontSize="18"
                 Margin="0,0,0,12"/>

      <HyperlinkButton Foreground="{ThemeResource SystemAccentColor}"
                       Command="{x:Bind ViewModel.ShowLearnCommand}"
                       ToolTipService.ToolTip="{x:Bind LearnTooltipString}">
        <StackPanel Orientation="Horizontal">
          <controls:Icon Symbol="Book"/>
          <TextBlock Margin="8 0 0 0"
                     Text="{x:Bind LearnString}"/>
        </StackPanel>
      </HyperlinkButton>

      <HyperlinkButton Foreground="{ThemeResource SystemAccentColor}"
                       Command="{x:Bind ViewModel.ShowForumCommand}"
                       ToolTipService.ToolTip="{x:Bind ForumTooltipString}">
        <StackPanel Orientation="Horizontal">
          <controls:Icon Symbol="Chat"/>
          <TextBlock Margin="8 0 0 0"
                     Text="{x:Bind ForumString}"/>
        </StackPanel>
      </HyperlinkButton>
    </StackPanel>

    <!-- Recent section -->
    <StackPanel Grid.Row="5"
                Grid.Column="1"
                Spacing="2">

      <TextBlock Text="{x:Bind RecentString}"
                 FontSize="18"
                 Margin="0,0,0,12"/>

      <ItemsControl x:Name="RecentFilesList"
                    ItemsSource="{x:Bind ViewModel.RecentProjects}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>

            <StackPanel Orientation="Horizontal">

              <controls:ProjectAvatar ProjectName="{Binding ProjectName}"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"/>

              <Grid MinWidth="100">
                <HyperlinkButton Foreground="{ThemeResource SystemAccentColor}"
                                 Click="RecentProjectButton_Click"
                                 ToolTipService.ToolTip="{Binding ProjectFilePath}"
                                 ToolTipService.Placement="Bottom">
                    <TextBlock Margin="8 0 0 0"
                               Text="{Binding ProjectName}"/>
                </HyperlinkButton>
              </Grid>

              <TextBlock VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         Text="{Binding ProjectFolderPath, Converter={StaticResource AbbreviatedPathConverter}}"/>
            </StackPanel>
            
          </DataTemplate>
        </ItemsControl.ItemTemplate>

      </ItemsControl>

    </StackPanel>
    
  </Grid>
</Page>
