<Project Sdk="Uno.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.22621;net10.0-desktop</TargetFrameworks>
    <UnoDisableVSWarnNetIsFirst>true</UnoDisableVSWarnNetIsFirst>
    <UnoSingleProject>true</UnoSingleProject>
    <OutputType>Library</OutputType>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <UnoFeatures>
      CSharpMarkup;
      Lottie;
      Hosting;
      Toolkit;
      Logging;
      Mvvm;
      Configuration;
      Localization;
      ThemeService;
    </UnoFeatures>

  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Celbridge.Foundation\Celbridge.Foundation.csproj" />
    <ProjectReference Include="..\..\Core\Celbridge.WebHost\Celbridge.WebHost.csproj" />
    <!-- Generates Resources/ColorTokens.xaml. UndefineProperties stops a global TargetFramework
         (e.g. dotnet build -f net10.0-desktop) from forcing that framework onto the net10.0 generator. -->
    <ProjectReference Include="..\..\Core\Celbridge.DesignTokens\Celbridge.DesignTokens.csproj"
                      ReferenceOutputAssembly="false"
                      UndefineProperties="TargetFramework" />
  </ItemGroup>

  <PropertyGroup>
    <!-- ColorTokens.xaml is generated during the build, so it does not exist when the SDK evaluates its
         default XAML glob on a clean checkout. Exclude it from that glob and declare it explicitly below,
         which holds the item from evaluation onwards whether or not the file is there yet. -->
    <CelbridgeDefaultItemExcludes>$(CelbridgeDefaultItemExcludes);Resources\ColorTokens.xaml</CelbridgeDefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Page Include="Resources\ColorTokens.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" />
  </ItemGroup>

  <PropertyGroup>
    <CelbridgeDefaultItemExcludes>$(CelbridgeDefaultItemExcludes);Assets\Fonts\**\*.json;Assets\Fonts\**\build\**</CelbridgeDefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- A font is loaded by URI, so a .ttf has to be a real file in the package: those ship via the Assets
         glob. The JSON maps are read as data instead, so they are embedded, which resolves the same way on
         every head and needs no app package. -->
    <EmbeddedResource Include="Assets\Fonts\**\*.json" Exclude="Assets\Fonts\**\build\**" />

    <!-- That Assets glob is declared in the WinAppSDK props, which are imported before this file is read,
         so the exclusions above cannot reach it and the items are removed here instead. The JSON maps are
         embedded rather than served loose, and the `build/` subfolder holds the npm tooling used to
         refresh the vendored icon data, which is not an asset at all. -->
    <Content Remove="Assets\Fonts\**\*.json" />
    <Content Remove="Assets\Fonts\**\build\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Celbridge.Tests" />
  </ItemGroup>

</Project>

