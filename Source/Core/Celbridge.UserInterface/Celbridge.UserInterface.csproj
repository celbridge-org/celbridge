<Project Sdk="Uno.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.22621;net10.0-desktop</TargetFrameworks>
    <UnoDisableVSWarnNetIsFirst>true</UnoDisableVSWarnNetIsFirst>
    <UnoSingleProject>true</UnoSingleProject>
    <OutputType>Library</OutputType>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <UnoFeatures>
      CSharpMarkup;
      Lottie;
      Hosting;
      Toolkit;
      Logging;
      Mvvm;
      Configuration;
      Localization;
      ThemeService;
    </UnoFeatures>

  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Celbridge.Foundation\Celbridge.Foundation.csproj" />
    <ProjectReference Include="..\..\Core\Celbridge.WebHost\Celbridge.WebHost.csproj" />
    <!-- Generates Resources/ColorTokens.xaml. UndefineProperties stops a global TargetFramework
         (e.g. dotnet build -f net10.0-desktop) from forcing that framework onto the net10.0 generator. -->
    <ProjectReference Include="..\..\Core\Celbridge.DesignTokens\Celbridge.DesignTokens.csproj"
                      ReferenceOutputAssembly="false"
                      UndefineProperties="TargetFramework" />
  </ItemGroup>

  <PropertyGroup>
    <!-- ColorTokens.xaml is generated during the build, so it does not exist when the SDK evaluates its
         default XAML glob on a clean checkout. Exclude it from that glob and declare it explicitly below,
         which holds the item from evaluation onwards whether or not the file is there yet. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Resources\ColorTokens.xaml</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Page Include="Resources\ColorTokens.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Excluded from the default Content glob because they are embedded below, not served as loose files. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Assets\Fonts\**\*.json</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- The .ttf fonts under Assets/Fonts ship automatically as loose Content via the Uno SDK's implicit
         Assets glob and load through ms-appx, so they need no entry here. Only the JSON glyph maps are
         embedded, because IconService reads them through GetManifestResourceStream. -->
    <EmbeddedResource Include="Assets\Fonts\**\*.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Celbridge.Tests" />
  </ItemGroup>

</Project>

