<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:services="using:Celbridge.UserInterface.Services">

    <!-- Converts a boolean value to an opacity value (true = 1.0, false = 0.0) -->
    <services:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
    
    <!-- Converts a boolean value to a Visibility value (true = Visible, false = Collapsed) -->
    <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

    <!-- Converts a boolean value to an accent color brush (true = accent, false = transparent) -->
    <services:BoolToAccentColorConverter x:Key="BoolToAccentColorConverter"/>

    <!-- Shortens an absolute path for display, replacing the user's home folder with a tilde -->
    <services:AbbreviatedPathConverter x:Key="AbbreviatedPathConverter"/>

</ResourceDictionary>
