<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Anything taking a palette colour is generated into ColorTokens.xaml, the WinUI control keys redirected
       onto the palette included: a redirect has to be declared once per theme, and only that dictionary has
       the colours in scope. What stays here takes no palette colour. -->

  <!-- Hack to get title bar color to work - see https://github.com/microsoft/microsoft-ui-xaml/issues/7125 -->
  <SolidColorBrush x:Key="WindowCaptionBackground" Color="Transparent" Opacity="0.5"/>
  <SolidColorBrush x:Key="WindowCaptionBackgroundDisabled" Color="Transparent"/>

</ResourceDictionary>
