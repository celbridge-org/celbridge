<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>

    <!-- Every background surface takes one of three roles. Content is where a document, tree, list or editor
         canvas lives and sits at the extreme end of the value range. Chrome carries tab strips, panel headers,
         toolbars, the rail and the title bar, and sits toward the middle. The gutter is the channel between
         two panels and sits beyond chrome, on the far side from content. PanelEdge is the hairline a surface
         presents to a gutter, one step beyond it again. The ramp runs content, chrome, gutter, edge in even
         steps, and the rule is the same in both themes, so it runs upward in dark mode and downward in light.

         PanelEdge is distinct from Divider, which is a hairline within a surface (a panel header underline,
         a toolbar's bottom edge) and stays subtle against the surface carrying it. -->

    <!-- Light Theme -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="ContentBackgroundColor">#FFFFFF</Color>
      <Color x:Key="ChromeBackgroundColor">#F3F3F3</Color>
      <Color x:Key="GutterColor">#E1E2E4</Color>
      <Color x:Key="PanelEdgeColor">#D0D0D0</Color>
      <Color x:Key="TitleBarActiveColor">#F3F3F3</Color>
      <Color x:Key="TitleBarInactiveColor">#E5E5E5</Color>
      <Color x:Key="DividerColor">#D0D0D0</Color>
      <Color x:Key="ErrorTextColor">#D32F2F</Color>
      <Color x:Key="WarningTextColor">#FFA000</Color>
      <Color x:Key="SearchMatchHighlightColor">#C66300</Color>
      <Color x:Key="ListItemSelectedBackgroundColor">#3C0078D4</Color>
    </ResourceDictionary>

    <!-- Dark Theme -->
    <ResourceDictionary x:Key="Dark">
      <!-- Content sits within four units of the Monaco and terminal canvases, so a document's own chrome
           meets its canvas without a visible seam. -->
      <Color x:Key="ContentBackgroundColor">#1E1F22</Color>
      <Color x:Key="ChromeBackgroundColor">#2B2D30</Color>
      <Color x:Key="GutterColor">#3D3F43</Color>
      <Color x:Key="PanelEdgeColor">#4F5155</Color>
      <Color x:Key="TitleBarActiveColor">#2B2D30</Color>
      <Color x:Key="TitleBarInactiveColor">#3B3E40</Color>
      <!-- Lighter than both surface tones so a divider reads against either. -->
      <Color x:Key="DividerColor">#393B40</Color>
      <Color x:Key="ErrorTextColor">#FF5252</Color>
      <Color x:Key="WarningTextColor">#FFCA28</Color>
      <Color x:Key="SearchMatchHighlightColor">#FFD966</Color>
      <Color x:Key="ListItemSelectedBackgroundColor">#3C0078D4</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="ContentBackgroundBrush"
                     Color="{ThemeResource ContentBackgroundColor}" />

  <SolidColorBrush x:Key="ChromeBackgroundBrush"
                     Color="{ThemeResource ChromeBackgroundColor}" />

  <SolidColorBrush x:Key="GutterBrush"
                     Color="{ThemeResource GutterColor}" />

  <SolidColorBrush x:Key="PanelEdgeBrush"
                     Color="{ThemeResource PanelEdgeColor}" />

  <SolidColorBrush x:Key="DividerBrush"
                     Color="{ThemeResource DividerColor}" />

  <SolidColorBrush x:Key="ErrorTextBrush"
                     Color="{ThemeResource ErrorTextColor}" />

  <SolidColorBrush x:Key="SearchMatchHighlightBrush"
                     Color="{ThemeResource SearchMatchHighlightColor}" />

  <SolidColorBrush x:Key="ListItemSelectedBackgroundBrush"
                     Color="{ThemeResource ListItemSelectedBackgroundColor}" />

  <!-- Hack to get title bar color to work - see https://github.com/microsoft/microsoft-ui-xaml/issues/7125 -->
  <SolidColorBrush x:Key="WindowCaptionBackground" Color="Transparent" Opacity="0.5"/>
  <SolidColorBrush x:Key="WindowCaptionBackgroundDisabled" Color="Transparent"/>

</ResourceDictionary>
