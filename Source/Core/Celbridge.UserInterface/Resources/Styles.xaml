<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Shared icon sizes. Reference these instead of literal FontSize values to keep icon sizing consistent.
       Medium is the default for command icons; Small and Large are the denser and more prominent steps. -->
  <x:Double x:Key="IconSizeSmall">16</x:Double>
  <x:Double x:Key="IconSizeMedium">18</x:Double>
  <x:Double x:Key="IconSizeLarge">22</x:Double>

  <!-- The type scale, mirroring the type tokens in the web client's celbridge-tokens.css; keep the two in
       sync when either changes. Small carries panel titles, field labels and supporting prose. Base carries
       input, button and body text, and is the WinUI default. Heading carries the section heading. Reference
       the named text styles below rather than setting FontSize, FontWeight or Foreground on a TextBlock. -->
  <x:Double x:Key="FontSizeSmall">12</x:Double>
  <x:Double x:Key="FontSizeBase">14</x:Double>
  <x:Double x:Key="FontSizeHeading">16</x:Double>

  <!-- The persistent identity of a panel, not the title of its content. -->
  <Style x:Key="PanelTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
  </Style>

  <!-- The name of the section on screen, and the largest text in a panel. -->
  <Style x:Key="SectionHeadingTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
  </Style>

  <!-- The name of an entry in a list of cards or rows, above its metadata. -->
  <Style x:Key="ListItemTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBase}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
  </Style>

  <!-- The label naming a form control. -->
  <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
  </Style>

  <!-- Text the reader can skip: a section description, a field hint, a footer note, list item metadata. -->
  <Style x:Key="SupportingTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
  </Style>

  <!-- A flat icon button: a transparent hit target that tints on hover and press, and dims when disabled.
       Carries the same four-pixel corner radius as the app's default-templated buttons, because replacing
       the control template drops the framework's own rounding. Size its icon content from the IconSize
       tokens above. Applies to Button only, so a ToggleButton keeps its own chrome and stays legible when
       checked. -->
  <Style x:Key="TransparentIconButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinWidth" Value="32"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter x:Name="ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                   Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SystemListLowColor}"/>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                   Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SystemListMediumColor}"/>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                   Storyboard.TargetProperty="Opacity">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="0.5"/>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </ContentPresenter>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
