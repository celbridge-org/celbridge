<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Celbridge.UserInterface.Views.Controls">

  <!-- Shared icon sizes. Reference these instead of literal FontSize values to keep icon sizing consistent.
       Medium is the size every command icon takes, in the application toolbar, the panel headers and the
       utility rail alike; Small is the denser step. -->
  <x:Double x:Key="IconSizeSmall">16</x:Double>
  <x:Double x:Key="IconSizeMedium">18</x:Double>

  <!-- The channel between two panels. A splitter's grab area takes this size, which is what holds the gap
       open, so any layout that reserves a matching gap reads the same value rather than repeating it. -->
  <!-- The app icon is a filled mark rather than a line glyph, so it reads smaller than a command icon
       set to the same box. It takes its own size, chosen to sit optically level with them. -->
  <x:Double x:Key="AppIconSize">22</x:Double>

  <!-- WinUI sizes its top-mode navigation pane from this key, and centres the pane's items in it. Left at
       the framework's 48 the pane overhangs the shorter application toolbar, dropping the items below the
       icons beside them. Mirrors ApplicationToolbar.ToolbarHeight; keep the two in sync when either
       changes. -->
  <x:Double x:Key="NavigationViewTopPaneHeight">40</x:Double>

  <x:Double x:Key="GutterSize">7</x:Double>

  <!-- The widest the workspace notification toast can grow to. It is an overlay, so this caps how much
       of the workspace a long line covers rather than reserving anything. -->
  <x:Double x:Key="WorkspaceToastMaxWidth">420</x:Double>

  <!-- Rounding on a panel corner where two gutters meet on the outside of its area, so a corner sitting on
       the application border or on an area's internal split stays square. The bottom corners round only on a
       head that clips a hosted web view to the rounding, because the document view fills the panel below the
       tab strip. Set this to 0 to square every corner off. -->
  <x:Double x:Key="PanelCornerRadius">14</x:Double>

  <!-- The type scale, mirroring the type tokens in the web client's celbridge-tokens.css; keep the two in
       sync when either changes. Small carries panel titles, field labels and supporting prose. Base carries
       input, button and body text, and is the WinUI default. Heading carries the section heading. Reference
       the named text styles below rather than setting FontSize, FontWeight or Foreground on a TextBlock. -->
  <x:Double x:Key="FontSizeSmall">12</x:Double>
  <x:Double x:Key="FontSizeBase">14</x:Double>
  <x:Double x:Key="FontSizeHeading">16</x:Double>

  <!-- The persistent identity of a panel, not the title of its content. -->
  <Style x:Key="PanelTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
  </Style>

  <!-- The name of the section on screen, and the largest text in a panel. -->
  <Style x:Key="SectionHeadingTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
  </Style>

  <!-- The name of an entry in a list of cards or rows, above its metadata. -->
  <Style x:Key="ListItemTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBase}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
  </Style>

  <!-- The label naming a form control. -->
  <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
  </Style>

  <!-- Text the reader can skip: a section description, a field hint, a footer note, list item metadata. -->
  <Style x:Key="SupportingTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
  </Style>

  <!-- The flat icon button: a transparent hit target that tints on hover and press and dims when disabled,
       taking the shared button tones. Sized from its content down to a 32px square floor, which an icon at
       the IconSize tokens above lands on exactly. Pair it with VerticalAlignment="Center" where the parent
       would otherwise stretch it. -->
  <Style x:Key="IconButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinWidth" Value="32"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter x:Name="ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                   Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonHoverBackgroundBrush}"/>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                   Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonActiveBackgroundBrush}"/>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                   Storyboard.TargetProperty="Opacity">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="0.5"/>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </ContentPresenter>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The flat icon toggle: IconButtonStyle with a checked state, which fills the button with the accent and
       puts its content in the tone chosen to read against it. The accent is reserved for this, so a control
       with no selected state never takes it. -->
  <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinWidth" Value="32"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <ContentPresenter x:Name="ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                   Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonHoverBackgroundBrush}"/>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                   Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonActiveBackgroundBrush}"/>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                   Storyboard.TargetProperty="Opacity">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="0.5"/>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Checked">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                   Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentBrush}"/>
                    </ObjectAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                   Storyboard.TargetProperty="Foreground">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentTextBrush}"/>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                   Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentBrush}"/>
                    </ObjectAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                   Storyboard.TargetProperty="Foreground">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentTextBrush}"/>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                   Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentBrush}"/>
                    </ObjectAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                   Storyboard.TargetProperty="Foreground">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentTextBrush}"/>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </ContentPresenter>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A project row in a menu. The path goes on a second line rather than in a column beside the name: a
       path long enough to fill the menu squeezes a single-line row's name down to nothing. The padding and
       spacing put the avatar and name in the WinUI MenuFlyoutItem icon and text columns. -->
  <Style x:Key="ProjectMenuItemStyle" TargetType="controls:ProjectMenuItem">
    <Setter Property="MinWidth" Value="320"/>
    <Setter Property="MaxWidth" Value="460"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:ProjectMenuItem">
          <Border x:Name="LayoutRoot"
                  Background="Transparent"
                  CornerRadius="4"
                  Margin="4,1,4,1"
                  Padding="7,7,11,7">

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot"
                                                   Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonHoverBackgroundBrush}"/>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot"
                                                   Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonActiveBackgroundBrush}"/>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled"/>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <controls:ProjectAvatar Grid.Column="0"
                                      ProjectName="{TemplateBinding Text}"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Top"/>

              <StackPanel Grid.Column="1"
                          VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding Text}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{TemplateBinding SecondaryText}"
                           Style="{StaticResource SupportingTextStyle}"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The caption naming a group of menu items. It takes the panel title style because its weight is what
       separates it from the supporting text in the rows below. -->
  <Style x:Key="MenuSectionHeaderItemStyle" TargetType="controls:MenuSectionHeaderItem">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:MenuSectionHeaderItem">
          <TextBlock Text="{TemplateBinding Text}"
                     Style="{StaticResource PanelTitleTextStyle}"
                     Margin="43,7,15,4"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
