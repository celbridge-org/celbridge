<Project Sdk="Uno.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.22621;net10.0-desktop</TargetFrameworks>
    <UnoDisableVSWarnNetIsFirst>true</UnoDisableVSWarnNetIsFirst>
    <UnoSingleProject>true</UnoSingleProject>
    <OutputType>Library</OutputType>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- MacOSWebViewInterop builds an Objective-C callback block from a function pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <UnoFeatures>
      CSharpMarkup;
      Lottie;
      Hosting;
      Toolkit;
      Logging;
      Mvvm;
      Configuration;
      Localization;
      ThemeService;
    </UnoFeatures>

  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Celbridge.FileSystem\Celbridge.FileSystem.csproj" />
    <ProjectReference Include="..\..\Core\Celbridge.Foundation\Celbridge.Foundation.csproj" />
    <ProjectReference Include="..\..\Core\Celbridge.Host\Celbridge.Host.csproj" />
    <ProjectReference Include="..\..\Core\Celbridge.Utilities\Celbridge.Utilities.csproj" />
    <!-- Generates Web/celbridge-client/celbridge-tokens.css. UndefineProperties stops a global
         TargetFramework (e.g. dotnet build -f net10.0-desktop) from forcing that framework onto the
         net10.0 generator. -->
    <ProjectReference Include="..\..\Core\Celbridge.DesignTokens\Celbridge.DesignTokens.csproj"
                      ReferenceOutputAssembly="false"
                      UndefineProperties="TargetFramework" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" />
  </ItemGroup>

  <ItemGroup>
    <!-- The token sheet is declared on its own rather than left to the wildcard, which would miss it on a
         clean checkout where the generator has not run yet. -->
    <Content Include="Web\**" Exclude="Web\**\node_modules\**;Web\celbridge-client\celbridge-tokens.css" />
    <Content Include="Web\celbridge-client\celbridge-tokens.css" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Celbridge.Tests" />
  </ItemGroup>

</Project>
