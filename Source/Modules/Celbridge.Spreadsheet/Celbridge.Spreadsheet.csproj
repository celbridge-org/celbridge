<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.22621;net10.0-desktop</TargetFrameworks>
    <UnoDisableVSWarnNetIsFirst>true</UnoDisableVSWarnNetIsFirst>
    <UnoSingleProject>true</UnoSingleProject>
    <OutputType>Library</OutputType>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <UnoFeatures>
      Hosting;
    </UnoFeatures>

    <!-- Turn off this project's resource index. MakePri reads the ja and ko parts of two SpreadJS resource file
         names as languages. MakePri expects a language-neutral copy of each file, and SpreadJS ships none. So
         each file raises warning PRI263. The loopback server reads the package's files from disk, and nothing
         reads the index. -->
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <IncludeProjectPriFile>false</IncludeProjectPriFile>

  </PropertyGroup>

  <ItemGroup>
    <Content Include="Package\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Celbridge.FileSystem\Celbridge.FileSystem.csproj" />
    <ProjectReference Include="..\..\Core\Celbridge.Foundation\Celbridge.Foundation.csproj" />
    <ProjectReference Include="..\..\Core\Celbridge.Utilities\Celbridge.Utilities.csproj" />
    <ProjectReference Include="..\..\Core\Celbridge.WebHost\Celbridge.WebHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
  </ItemGroup>

</Project>
