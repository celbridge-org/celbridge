<UserControl
    x:Class="Celbridge.WebView.Views.WebViewDocumentSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent">

    <!-- Leaving the settings belongs to the whole surface rather than to any one section, and the URL bar
         carrying the toggle back can be hidden, so the surface keeps a close of its own over the section
         heading. -->
    <controls:SettingsSectionSwitcher x:Name="SectionSwitcher"
                                      Margin="{StaticResource SettingsSurfaceMargin}"
                                      Sections="{x:Bind ViewModel.Sections, Mode=OneWay}"
                                      SelectedSection="{x:Bind ViewModel.SelectedSection, Mode=TwoWay}"
                                      CloseButtonTooltip="{x:Bind ReturnToPageString}" />
</UserControl>
