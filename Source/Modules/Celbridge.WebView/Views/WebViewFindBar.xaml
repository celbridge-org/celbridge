<UserControl
    x:Class="Celbridge.WebView.Views.WebViewFindBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Visibility="Collapsed">

    <Border Padding="8,4"
            Background="{ThemeResource ChromeBackgroundBrush}"
            BorderBrush="{ThemeResource DividerBrush}"
            BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal"
                    Spacing="6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
            <TextBox x:Name="FindTextBox"
                     Width="240"
                     MinHeight="32"
                     VerticalAlignment="Center"
                     KeyDown="FindTextBox_KeyDown"
                     TextChanged="FindTextBox_TextChanged" />
            <!-- Keeps the default ToggleButton chrome: the checked state is the control's whole
                 purpose, so the flat icon-button style would hide it. -->
            <ToggleButton x:Name="MatchCaseButton"
                          Padding="0"
                          MinWidth="32"
                          MinHeight="32"
                          VerticalAlignment="Center"
                          Click="MatchCaseButton_Click">
                <controls:Icon Symbol="MatchCase" FontSize="{StaticResource IconSizeMedium}" />
            </ToggleButton>
            <TextBlock x:Name="MatchSummaryText"
                       Style="{StaticResource SupportingTextStyle}"
                       VerticalAlignment="Center"
                       MinWidth="56"
                       Margin="4,0"
                       Visibility="Collapsed" />
            <Button x:Name="FindPreviousButton"
                    Style="{StaticResource TransparentIconButtonStyle}"
                    VerticalAlignment="Center"
                    Click="FindPreviousButton_Click">
                <controls:Icon Symbol="ChevronUp" FontSize="{StaticResource IconSizeMedium}" />
            </Button>
            <Button x:Name="FindNextButton"
                    Style="{StaticResource TransparentIconButtonStyle}"
                    VerticalAlignment="Center"
                    Click="FindNextButton_Click">
                <controls:Icon Symbol="ChevronDown" FontSize="{StaticResource IconSizeMedium}" />
            </Button>
            <Button x:Name="FindCloseButton"
                    Style="{StaticResource TransparentIconButtonStyle}"
                    VerticalAlignment="Center"
                    Click="FindCloseButton_Click">
                <controls:Icon Symbol="Close" FontSize="{StaticResource IconSizeMedium}" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
