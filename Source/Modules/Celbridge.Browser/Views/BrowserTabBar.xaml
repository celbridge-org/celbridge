<UserControl
    x:Class="Celbridge.Browser.Views.BrowserTabBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
    xmlns:local="using:Celbridge.Browser.Views"
    xmlns:vm="using:Celbridge.Browser.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>

        <!-- The close button sits beside the tab's button, so a press on it never counts as a press on the tab. -->
        <DataTemplate x:Key="TabTemplate" x:DataType="vm:BrowserTabViewModel">
            <Grid MinWidth="96"
                  MaxWidth="220"
                  Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Has the URL bar's color and no bottom edge. The row has no bottom padding, so the shown tab joins
                     the URL bar below. -->
                <Border Grid.ColumnSpan="2"
                        Background="{ThemeResource ChromeBackgroundBrush}"
                        BorderBrush="{ThemeResource DividerBrush}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="4,4,0,0"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind IsShown, Mode=OneWay}" />

                <Button Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="8,0,4,0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="{x:Bind Label, Mode=OneWay}"
                        AutomationProperties.AutomationId="BrowserTab"
                        AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                        Loaded="TabButton_Loaded"
                        Click="TabButton_Click">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <local:BrowserFaviconImage ImageBytes="{x:Bind Favicon, Mode=OneWay}"
                                                   VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Label, Mode=OneWay}"
                                   MaxWidth="150"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                    </StackPanel>
                </Button>

                <!-- The tooltip and accessible name are set in code-behind. -->
                <controls:IconButton Grid.Column="1"
                                     Margin="0,0,2,0"
                                     VerticalAlignment="Center"
                                     AutomationProperties.AutomationId="BrowserTabCloseButton"
                                     Loaded="CloseTabButton_Loaded"
                                     Click="CloseTabButton_Click">
                    <controls:Icon Symbol="Close" FontSize="{StaticResource IconSizeSmall}" />
                </controls:IconButton>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Border Padding="8,4,8,0"
            Background="{ThemeResource ContentBackgroundBrush}">
        <Grid x:Name="BarRoot"
              ColumnSpacing="4"
              SizeChanged="BarRoot_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tabs that do not fit are clipped at the right edge. The scroll viewer does the clipping, and the
                 shown tab scrolls into view. The canvas above the tabs draws the insertion marker during a drag. -->
            <Grid Grid.Column="0">
                <ScrollViewer x:Name="TabScrollViewer"
                              HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TabItems"
                                  HorizontalAlignment="Left"
                                  ItemTemplate="{StaticResource TabTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <Canvas x:Name="DragOverlay"
                        IsHitTestVisible="False">
                    <Border x:Name="InsertionMarker"
                            Width="2"
                            Height="30"
                            Background="{ThemeResource AccentBrush}"
                            Visibility="Collapsed" />
                </Canvas>
            </Grid>

            <!-- Outside the clipped strip, so it stays reachable however many tabs are open. The tooltip and
                 accessible name are set in code-behind. -->
            <controls:IconButton x:Name="NewTabButton"
                                 Grid.Column="1"
                                 VerticalAlignment="Center"
                                 AutomationProperties.AutomationId="BrowserNewTabButton"
                                 Click="NewTabButton_Click">
                <controls:Icon Symbol="Add" FontSize="{StaticResource IconSizeMedium}" />
            </controls:IconButton>
        </Grid>
    </Border>
</UserControl>
