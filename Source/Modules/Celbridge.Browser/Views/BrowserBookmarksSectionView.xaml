<UserControl
    x:Class="Celbridge.Browser.Views.BrowserBookmarksSectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Celbridge.UserInterface.Views.Controls"
    xmlns:local="using:Celbridge.Browser.Views"
    xmlns:vm="using:Celbridge.Browser.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

  <UserControl.Resources>

    <!-- The collapsed card identifies the bookmark the way its item in the bookmark list does. -->
    <DataTemplate x:Key="BookmarkHeaderTemplate" x:DataType="vm:BrowserBookmarkViewModel">
      <StackPanel Orientation="Horizontal"
                  Spacing="8"
                  VerticalAlignment="Center">
        <local:FaviconImage ImageBytes="{x:Bind Favicon, Mode=OneWay}"
                            VerticalAlignment="Center" />
        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                   Style="{StaticResource ListItemTitleTextStyle}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="BookmarkActionsTemplate" x:DataType="vm:BrowserBookmarkViewModel">
      <controls:IconButton VerticalAlignment="Center"
                           ToolTipService.ToolTip="{x:Bind OpenTooltip}"
                           AutomationProperties.Name="{x:Bind OpenTooltip}"
                           Click="OpenBookmarkButton_Click">
        <controls:Icon IconName="bs-arrow-up-right" FontSize="{StaticResource IconSizeMedium}" />
      </controls:IconButton>
    </DataTemplate>

    <DataTemplate x:Key="BookmarkBodyTemplate" x:DataType="vm:BrowserBookmarkViewModel">
      <StackPanel Spacing="12">

        <StackPanel Spacing="2">
          <TextBlock Text="{x:Bind UrlLabel}"
                     Style="{StaticResource FieldLabelTextStyle}" />
          <TextBox IsSpellCheckEnabled="False"
                   AutomationProperties.AutomationId="BookmarkUrlField"
                   AutomationProperties.Name="{x:Bind UrlLabel}"
                   PlaceholderText="{x:Bind UrlPlaceholder}"
                   Text="{x:Bind Url, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                   KeyDown="CommitField_KeyDown" />
          <TextBlock Text="{x:Bind InvalidUrlText}"
                     Style="{StaticResource SupportingTextStyle}"
                     Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                     TextWrapping="Wrap"
                     Visibility="{x:Bind IsUrlInvalid, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Spacing="2">
          <TextBlock Text="{x:Bind NameLabel}"
                     Style="{StaticResource FieldLabelTextStyle}" />
          <TextBox IsSpellCheckEnabled="False"
                   PlaceholderText="{x:Bind NamePlaceholder}"
                   Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                   KeyDown="CommitField_KeyDown" />
        </StackPanel>

        <StackPanel Spacing="2">
          <TextBlock Text="{x:Bind OpenOnStartLabel}"
                     Style="{StaticResource FieldLabelTextStyle}" />
          <ToggleSwitch MinWidth="0"
                        OnContent=""
                        OffContent=""
                        AutomationProperties.Name="{x:Bind OpenOnStartLabel}"
                        IsOn="{x:Bind OpenOnStart, Mode=TwoWay}" />
          <TextBlock Text="{x:Bind OpenOnStartHint}"
                     Style="{StaticResource SupportingTextStyle}"
                     TextWrapping="Wrap" />
        </StackPanel>

      </StackPanel>
    </DataTemplate>

  </UserControl.Resources>

  <StackPanel Spacing="12">

    <InfoBar x:Name="ReadOnlyInfoBar"
             AutomationProperties.AutomationId="BookmarksReadOnlyNotice"
             IsOpen="True"
             IsClosable="False"
             Severity="Informational"
             Message="{x:Bind ReadOnlyString}"
             Visibility="{x:Bind ViewModel.IsReadOnly, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

    <controls:CardListView x:Name="BookmarkCards"
                           HeaderTemplate="{StaticResource BookmarkHeaderTemplate}"
                           HeaderActionsTemplate="{StaticResource BookmarkActionsTemplate}"
                           BodyTemplate="{StaticResource BookmarkBodyTemplate}"
                           CardNamePath="DisplayName"
                           AddButtonText="{x:Bind AddBookmarkString}"
                           EmptyText="{x:Bind NoBookmarksString}"
                           IsReadOnly="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}">

      <controls:CardListView.AddRowContent>
        <Button Content="{x:Bind AddCurrentPageString}"
                IsEnabled="{x:Bind ViewModel.CanAddBookmarkFromCurrentPage, Mode=OneWay}"
                Click="AddCurrentPageButton_Click" />
      </controls:CardListView.AddRowContent>

    </controls:CardListView>

  </StackPanel>
</UserControl>
