# Files matched here are excluded from git. Celbridge does not read this file: what the
# Explorer hides and what search skips are set in the project's .celbridge file, under
# [celbridge.resources]. Edit freely. Your project's *.celbridge file is not matched by
# any pattern here and stays tracked.

# Celbridge project metadata
.celbridge/

# Build output
bin/
obj/
.vs/
node_modules/

# Editor and tooling
.vscode/
.idea/
.claude/
.mcp.json

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment and secrets
.env

# OS cruft
Thumbs.db
desktop.ini
.DS_Store

# Temporary and backup files
*.tmp
*.bak
*.swp
*.swo
*.swn
*.crdownload
*.part
~$*
