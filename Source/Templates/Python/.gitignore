# Files matched here are excluded from git. Celbridge does not read this file: what the
# Explorer hides and what search skips are set in the project's .celbridge file, under
# [celbridge.resources]. Edit freely. Your project's *.celbridge file is not matched by
# any pattern here and stays tracked.

# Celbridge project metadata
.celbridge/

# Files downloaded from web pages, kept here until moved where they are needed
/downloads/

# Compiled Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.so

# Installed dependencies
.venv/
venv/
node_modules/

# Build output
build/
dist/
*.egg-info/

# Tool output
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Notebook checkpoints
.ipynb_checkpoints/

# Editor and tooling
.vscode/
.idea/
.vs/
.claude/
.mcp.json

# Environment and secrets
.env

# OS cruft
Thumbs.db
desktop.ini
.DS_Store

# Temporary and backup files
*.tmp
*.bak
*.swp
*.swo
*.swn
*.crdownload
*.part
~$*
